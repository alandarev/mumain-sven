# A tracked project patch without a dirty submodule, pin change or fetched-source-only edit.
function(mu_prepare_rmlui output source)
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/rmlui-bd5f66-transform-cache.patch")
    set(pin "bd5f66a99e67ebe92201ecf87853f616f97b55ee")
    set(helper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ApplyGitPatch.cmake")
    set(expected "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/rmlui-bd5f66-transform-cache.sha256")
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT revision STREQUAL pin)
        message(FATAL_ERROR "RmlUi cache patch expects ${pin}, found ${revision}; review patch before repinning")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}" "${helper}" "${expected}")
    file(SHA256 "${patch}" patch_digest)
    file(SHA256 "${helper}" helper_digest)
    file(SHA256 "${expected}" expected_digest)
    string(SHA256 digest "${pin}:${patch_digest}:${helper_digest}:${expected_digest}")
    set(destination "${CMAKE_BINARY_DIR}/_deps/rmlui-${pin}-${digest}")
    if(NOT EXISTS "${destination}/.mu-patch-ready")
        file(MAKE_DIRECTORY "${destination}")
        # Archive the committed input, not a possibly edited vendor working tree. No .git copy.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" archive
            "--output=${destination}/.mu-source.tar" "${pin}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${destination}/.mu-source.tar"
            WORKING_DIRECTORY "${destination}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${destination}" "-DPATCH_FILE=${patch}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ApplyGitPatch.cmake" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    # Verify full once-patched files even when reusing a ready cache, never silently reuse duplicates.
    file(STRINGS "${expected}" identities)
    foreach(identity IN LISTS identities)
        if(NOT identity MATCHES "^([a-f0-9]+)  (.+)$")
            message(FATAL_ERROR "invalid RmlUi patch identity: ${identity}")
        endif()
        set(expected_hash "${CMAKE_MATCH_1}")
        set(expected_file "${CMAKE_MATCH_2}")
        file(SHA256 "${destination}/${expected_file}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "RmlUi materialization identity mismatch: ${expected_file}; preserve and reconfigure a fresh cache")
        endif()
    endforeach()
    if(EXISTS "${destination}/.mu-patch-ready")
        file(READ "${destination}/.mu-patch-ready" ready)
        if(NOT ready STREQUAL "${pin}\n${digest}\n")
            message(FATAL_ERROR "RmlUi materialization provenance mismatch")
        endif()
    else()
        file(WRITE "${destination}/.mu-patch-ready" "${pin}\n${digest}\n")
    endif()
    set(${output} "${destination}" PARENT_SCOPE)
endfunction()
