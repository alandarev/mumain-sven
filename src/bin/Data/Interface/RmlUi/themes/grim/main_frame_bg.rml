<rml>
<head>
<title>Grim Main Frame Background</title>
<link type="text/rcss" href="black_glass_sprites.rcss"/>
<link type="text/rcss" href="main_frame_bg.rcss"/>
</head>
<body data-model="main_frame_bg">
<div id="bg_root" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'" data-style-transform="'scale(' + root_scale + ')'">
<div id="bg_left" data-style-left="left_offset_x + 'px'">
<div class="potion-well well-0"></div>
<div class="potion-well well-1"></div>
<div class="potion-well well-2"></div>
<div class="potion-well well-3"></div>
</div>
<div id="skill_list_highlight" data-style-left="center_offset_x + 222 + 'px'" data-class-hidden="!skill_list_open"></div>
</div>
</body>
</rml>
