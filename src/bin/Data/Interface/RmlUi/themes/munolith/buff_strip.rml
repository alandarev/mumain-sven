<rml>
<head>
    <title>Corner Buff Strip</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="buff_strip.rcss"/>
</head>
<body data-model="buff_strip" data-style-font-size="hud_unit_px + 'px'">
    <div id="corner_effects">
        <div class="effect-row beneficial">
            <div class="effect" data-for="buff : beneficial" data-event-mouseup="buff_cancel(buff.slot)" data-class-expiring="buff.expiring">
                <div class="effect-frame"><div class="buff-icon-art" data-style-decorator="buff.decorator"></div></div>
                <div class="effect-time">{{buff.remaining}}</div>
                <div class="effect-tooltip">
                    <div class="tooltip-title">{{buff.tooltip_title}}</div>
                    <div class="tooltip-body">{{buff.tooltip_body}}</div>
                    <div class="tooltip-duration" data-class-hidden="buff.tooltip_duration == ''">{{buff.tooltip_duration}}</div>
                </div>
            </div>
        </div>
        <div class="effect-row harmful">
            <div class="effect" data-for="buff : harmful" data-event-mouseup="buff_cancel(buff.slot)" data-class-expiring="buff.expiring">
                <div class="effect-frame"><div class="buff-icon-art" data-style-decorator="buff.decorator"></div></div>
                <div class="effect-time">{{buff.remaining}}</div>
                <div class="effect-tooltip">
                    <div class="tooltip-title">{{buff.tooltip_title}}</div>
                    <div class="tooltip-body">{{buff.tooltip_body}}</div>
                    <div class="tooltip-duration" data-class-hidden="buff.tooltip_duration == ''">{{buff.tooltip_duration}}</div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
