body { font-family: "DejaVu Sans"; font-effect: outline(1px #07090b), shadow(1px 1px #000000); margin: 0; width: 100%; height: 100%; pointer-events: none; }
#panel { display: flex; flex-wrap: wrap; position: absolute; width: 200px; height: 96px; transform-origin: left top; pointer-events: none; }
.card { display: block; position: relative; width: 96px; height: 28px; margin: 2px; pointer-events: none; }
.card-fill { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border: 1px #536048; background-color: #101b14f5; }
.card-select { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; border: 1px #b9a46b; background-color: #71603844; }
.selected .card-select { display: block; }
.card-name { position: absolute; left: 5px; top: 3px; color: #d0d4bf; width: 65px; transform-origin: left top; }
.leader .card-name { color: #edcc83; }
.absent .card-name { color: #82907a; }
.absent .card-fill { background-color: #1a1914f5; }
.card-health-track { position: absolute; left: 5px; width: 86px; bottom: 4px; height: 4px; background-color: #323c29; }
.card-health { display: block; height: 100%; background-color: #973f36; }
.defense .card-health { background-color: #698751; }
.absent .card-health { background-color: #514f3a; }
.card-leave { display: block; position: absolute; right: 3px; top: 2px; width: 13px; height: 13px; line-height: 13px; color: #adad96; text-align: center; cursor: pointer; pointer-events: auto; }
.card-leave:hover { color: #f3d9a1; background-color: #776746; }
