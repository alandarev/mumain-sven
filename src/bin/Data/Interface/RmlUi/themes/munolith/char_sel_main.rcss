#panel { position: absolute; left: 0; top: 0; width: 100%; height: 94.5vh; pointer-events: none; }
.btn-icon { position: absolute; width: 54rem; height: 30rem; bottom: 11rem; }
#btn_create { left: 22rem; }
#btn_menu { left: 77rem; }
#btn_connect { right: 77rem; }
#btn_delete { right: 22rem; }
.btn-icon-label { display: block; position: absolute; left: 0; right: 0; top: 0; height: 30rem; line-height: 30rem; text-align: center; font-size: 10rem; color: inherit; pointer-events: none; }
.btn-icon-caption, .deco { display: none; }
.info-bar { position: absolute; left: 133rem; right: 133rem; bottom: 15rem; height: 21rem; background-color: #10190fb0; border-top: 1rem #6b6646; pointer-events: none; }
#account_block_message { position: absolute; left: 0; top: 330rem; width: 640rem; pointer-events: none; }
#account_block_message.hidden { display: none; }
.line-row { line-height: 18rem; text-align: center; }
.line { display: inline-block; color: #ff796a; background-color: #10190fee; white-space: normal; padding: 0 2rem; }
