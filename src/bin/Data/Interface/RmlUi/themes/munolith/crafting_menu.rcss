@spritesheet satchel-top { src: "../../../newui_item_back04.tga"; sat-top-left: 0px 0px 48px 42px; sat-top-mid: 64px 0px 62px 42px; sat-top-right: 130px 0px 60px 42px; }
@spritesheet satchel-bottom { src: "../../../newui_item_back03.tga"; sat-bottom-left: 0px 0px 36px 45px; sat-bottom-mid: 64px 0px 62px 45px; sat-bottom-right: 154px 0px 36px 45px; }
@spritesheet satchel-left { src: "../../../newui_item_back02-L.tga"; sat-side-left: 0px 0px 12px 320px; }
@spritesheet satchel-right { src: "../../../newui_item_back02-R.tga"; sat-side-right: 9px 0px 12px 320px; }
@spritesheet satchel-stone { src: "../../../newui_msgbox_back.jpg"; sat-stone: 0px 0px 190px 429px; }

#panel.crafting-menu { width: 250dp; max-width: 90vw; max-height: 90vh; top: 50%; margin-left: 0; transform: translate(-50%, -50%); }
#panel.crafting-menu .window-shell-sprite-back, #panel.crafting-menu .window-shell-header-title, #panel.crafting-menu .window-shell-sprite-top, #panel.crafting-menu .window-shell-sprite-middle, #panel.crafting-menu .window-shell-sprite-bottom, #panel.crafting-menu .window-shell-header-rail { display: none; }
#panel.crafting-menu .window-shell-content { left: 0; right: 0; top: 0; bottom: 0; margin: 0; }
#panel.crafting-menu .crafting-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-family: "DejaVu Sans"; color: #d5ccb7; }
#panel.crafting-menu .craft-stone, #panel.crafting-menu .craft-shade { position: absolute; left: 5dp; right: 5dp; top: 7dp; bottom: 7dp; }
#panel.crafting-menu .craft-stone { decorator: image(sat-stone); }
#panel.crafting-menu .craft-shade { background-color: #080d0cf5; }
#panel.crafting-menu .craft-trim { position: absolute; pointer-events: none; }
#panel.crafting-menu .craft-top-left { top: 0; left: 0; width: 31dp; height: 27dp; decorator: image(sat-top-left); }
#panel.crafting-menu .craft-top-mid { top: 0; left: 31dp; right: 39dp; height: 27dp; decorator: image(sat-top-mid); }
#panel.crafting-menu .craft-top-right { top: 0; right: 0; width: 39dp; height: 27dp; decorator: image(sat-top-right); }
#panel.crafting-menu .craft-side-left { top: 26dp; bottom: 23dp; left: 0; width: 7dp; decorator: image(sat-side-left); }
#panel.crafting-menu .craft-side-right { top: 26dp; bottom: 23dp; right: 0; width: 7dp; decorator: image(sat-side-right); }
#panel.crafting-menu .craft-bottom-left { bottom: 0; left: 0; width: 23dp; height: 28dp; decorator: image(sat-bottom-left); }
#panel.crafting-menu .craft-bottom-mid { bottom: 0; left: 23dp; right: 23dp; height: 28dp; decorator: image(sat-bottom-mid); }
#panel.crafting-menu .craft-bottom-right { bottom: 0; right: 0; width: 23dp; height: 28dp; decorator: image(sat-bottom-right); }
#panel.crafting-menu .crafting-title { position: absolute; left: 20dp; right: 20dp; top: 8dp; text-align: center; color: #d7b864; font-size: 1rem; }
#panel.crafting-menu .crafting-methods { position: absolute; left: 15dp; right: 15dp; top: 38dp; bottom: 25dp; overflow: hidden auto; }
#panel.crafting-menu .crafting-choice { display: block; margin-bottom: 10dp; }
#panel.crafting-menu .crafting-description { display: block; color: #a9a48e; font-size: 1rem; text-align: left; }
#panel.crafting-menu .crafting-method { display: block; box-sizing: border-box; width: 100%; min-height: 26dp; margin-top: 5dp; padding: 4dp 6dp; font-family: "DejaVu Sans"; font-size: 1rem; color: #ded1ac; background-color: #343422; border: 1dp #6b6646; }
#panel.crafting-menu .crafting-method:hover { background-color: #51482b; border-color: #c9a65c; }
#panel.crafting-menu .crafting-method.compact { width: 100dp; margin-left: auto; margin-right: auto; }
#panel.crafting-menu scrollbarvertical { width: 5dp; }
#panel.crafting-menu scrollbarvertical slidertrack { background-color: #10170d; }
#panel.crafting-menu scrollbarvertical sliderbar { background-color: #766b45; min-height: 15dp; }

#panel.crafting-menu .crafting-summary { margin-bottom: 10dp; }
#panel.crafting-menu .crafting-description.bold { font-weight: bold; }

#panel.crafting-menu .crafting-corner-close { position: absolute; right: 5dp; top: 3dp; width: 10dp; height: 12dp; padding: 0; border-width: 0; background-color: transparent; color: #d7b864; font-size: 1rem; pointer-events: auto; }
#panel.crafting-menu scrollbarvertical slidertrack, #panel.crafting-menu scrollbarvertical sliderbar, #panel.crafting-menu scrollbarvertical sliderarrowdec, #panel.crafting-menu scrollbarvertical sliderarrowinc { decorator: none; }
#panel.crafting-menu scrollbarvertical sliderbar { height: auto; }
#panel.crafting-menu scrollbarvertical sliderarrowdec, #panel.crafting-menu scrollbarvertical sliderarrowinc { height: 0; }

body.crafting-menu #panel { --canvas-top: 0dp; }
