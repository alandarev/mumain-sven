<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Castle service</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="siege_service_common.rcss"/></head><body><div id="panel" class="catapult-desk" data-model="catapult" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-330 readable-text counter-scaled scaled-reference">{{title}}</span></div><button class="corner-close" data-event-click="catapult_exit">×</button><div class="catapult-content scroll-pane scaled-width-330 scaled-height-100 readable-text counter-scaled scaled-reference"><div class="service-line" data-for="l : lines">{{l.text}}</div></div><div class="target-areas" data-class-attack="mode == 1" data-class-defense="mode == 2"><button class="target-area" data-for="a : areas" data-class-selected="a.locked" data-event-click="catapult_area(a.index)"><span class="native-text scaled-width-145 readable-text counter-scaled scaled-reference">{{a.label}}</span></button></div><button class="fire-action" data-class-locked="fire_locked" data-attrif-disabled="fire_locked" data-event-click="catapult_fire"><span class="native-text scaled-width-320 readable-text counter-scaled scaled-reference">{{fire_text}}</span></button><button class="desk-close" data-event-click="catapult_exit"><span class="native-text scaled-width-330 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></body></rml>
