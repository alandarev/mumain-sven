<rml><head><link type="text/rcss" href="event_item_target.rcss"/><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Event entry</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="event_desk_common.rcss"/></head><body data-model="empire_guardian_enter"><div id="panel" class="ticket-desk guardian"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div><img id="entry_item" class="entry-item"/><div id="title"><span class="native-text scaled-width-151 counter-scaled scaled-reference" data-style-font-size="((text_px < 11 ? 11 : text_px) * 1.1) + 'px'">{{texts[0].text}}</span></div><button class="corner-close" data-event-click="window_close">×</button><div class="ticket-descriptions scroll-pane scaled-width-160 scaled-height-72 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'"><div class="ticket-description">{{texts[1].text}}</div><div class="ticket-description">{{texts[2].text}}</div><div class="ticket-description">{{texts[3].text}}</div><div class="ticket-description">{{texts[4].text}}</div></div><div class="ticket-well entry-item-box"></div><div class="ticket-name"><span class="native-text scaled-width-160 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{texts[5].text}}</span></div><div class="ticket-details scroll-pane scaled-width-160 scaled-height-114 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'"><div class="ticket-detail warning">{{texts[6].text}}</div><div class="ticket-detail">{{texts[7].text}}</div><div class="ticket-detail">{{texts[8].text}}</div><div class="ticket-detail">{{texts[9].text}}</div><div class="ticket-detail">{{texts[10].text}}</div><div class="ticket-detail">{{texts[11].text}}</div></div><div class="actions"><button data-for="b, i : buttons" data-class-locked="b.locked" data-attrif-disabled="b.locked" data-event-click="item_entry_press(i)"><span class="native-text scaled-width-76 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{b.label}}</span></button></div></div></body></rml>
