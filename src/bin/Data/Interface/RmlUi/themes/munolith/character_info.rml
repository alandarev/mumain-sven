<!-- rml-contract-optional-callback: chainfo_increase_stat: Armory uses its validated batch editor armory_step/input/apply instead of immediate one-point requests -->
<rml><head><title>Character Armory</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="character_info.rcss"/></head>
<body data-model="character_info">
<div id="panel">
<div class="armory-face counter-scaled">
<div class="stone"/><div class="stone-shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/>
<div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/>
<div id="title" class="title">{{armory_title}}</div><button class="close" title="Close Character" data-event-click="window_close">×</button>
<div class="armory-body">
<div class="armory-left">
<div class="model-well"><div class="model-back"/><div id="armory_model_controls" title="Drag to rotate and tilt · Scroll to zoom"><img id="armory_preview"/></div>
<div class="gear-column gear-left"><div id="armory_slot_2" data-event-mouseup="armory_equipment_click(2)" class="gear-slot" data-event-mouseover="armory_hover(2, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(2, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_2"/></div><span>Helm</span></div><div id="armory_slot_3" data-event-mouseup="armory_equipment_click(3)" class="gear-slot" data-event-mouseover="armory_hover(3, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(3, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_3"/></div><span>Armor</span></div><div id="armory_slot_5" data-event-mouseup="armory_equipment_click(5)" class="gear-slot" data-event-mouseover="armory_hover(5, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(5, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_5"/></div><span>Gloves</span></div><div id="armory_slot_4" data-event-mouseup="armory_equipment_click(4)" class="gear-slot" data-event-mouseover="armory_hover(4, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(4, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_4"/></div><span>Pants</span></div><div id="armory_slot_6" data-event-mouseup="armory_equipment_click(6)" class="gear-slot" data-event-mouseover="armory_hover(6, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(6, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_6"/></div><span>Boots</span></div></div><div class="gear-column gear-right"><div id="armory_slot_7" data-event-mouseup="armory_equipment_click(7)" class="gear-slot" data-event-mouseover="armory_hover(7, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(7, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_7"/></div><span>Wings</span></div><div id="armory_slot_8" data-event-mouseup="armory_equipment_click(8)" class="gear-slot" data-event-mouseover="armory_hover(8, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(8, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_8"/></div><span>Pet</span></div><div id="armory_slot_9" data-event-mouseup="armory_equipment_click(9)" class="gear-slot" data-event-mouseover="armory_hover(9, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(9, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_9"/></div><span>Pendant</span></div><div id="armory_slot_10" data-event-mouseup="armory_equipment_click(10)" class="gear-slot" data-event-mouseover="armory_hover(10, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(10, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_10"/></div><span>Ring</span></div><div id="armory_slot_11" data-event-mouseup="armory_equipment_click(11)" class="gear-slot" data-event-mouseover="armory_hover(11, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(11, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_11"/></div><span>Ring</span></div></div>
<div class="hands"><div id="armory_slot_0" data-event-mouseup="armory_equipment_click(0)" class="gear-slot hand" data-event-mouseover="armory_hover(0, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(0, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_0"/></div><span>Main hand</span></div><div id="armory_slot_1" data-event-mouseup="armory_equipment_click(1)" class="gear-slot hand" data-event-mouseover="armory_hover(1, -1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(1, -1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><div class="gear-image"><img id="armory_item_1"/></div><span>Off hand</span></div></div>
</div>
<div class="attributes" data-class-editing="armory_editing">
<div class="section-head">Attributes</div>
<div class="points-caption" data-if="armory_editing">Points to add</div>
<div class="attribute-row" data-for="attribute : armory_attributes" data-class-highlighted="attribute.highlighted" data-event-mouseover="armory_attribute_hover(attribute.index)" data-event-mouseout="armory_attribute_hover(-1)" data-event-focus="armory_attribute_hover(attribute.index)" data-event-blur="armory_attribute_hover(-1)" tabindex="0">
<span class="attribute-label">{{attribute.label}}</span><span class="attribute-total" data-class-proposed="attribute.proposed" data-attr-title="attribute.explanation">{{attribute.total}}</span>
<div class="attribute-controls" data-if="armory_editing">
<button data-event-click="armory_step(attribute.index, -1)" data-attrif-disabled="armory_waiting || attribute.addition == 0" data-class-disabled="armory_waiting || attribute.addition == 0">−</button>
<input type="text" maxlength="5" data-attr-value="attribute.input" data-event-change="armory_input(attribute.index)" data-attrif-disabled="armory_waiting"/>
<button data-event-click="armory_step(attribute.index, 1)" data-attrif-disabled="armory_waiting" data-class-disabled="armory_waiting">+</button></div>
<span class="attribute-note" data-if="attribute.note != ''">{{attribute.note}}</span></div>
<button class="free-points" data-if="!armory_editing" data-event-click="armory_edit" data-attrif-disabled="!armory_ready || armory_points == '0'" data-class-disabled="!armory_ready || armory_points == '0'"><span>Free Points</span><span>{{armory_points}}  ›</span></button>
<div class="allocation-footer" data-if="armory_editing"><span data-class-over-budget="armory_over_budget">{{armory_budget}}</span><button class="apply" data-event-click="armory_apply" data-attrif-disabled="!armory_valid || armory_waiting" data-class-disabled="!armory_valid || armory_waiting">Apply</button><button data-event-click="armory_cancel" data-attrif-disabled="armory_waiting" data-class-disabled="armory_waiting">Cancel</button></div>
</div></div>
<div class="armory-right">
<div class="skill-card"><div class="eyebrow">Selected skill</div><div class="skill-heading"><span class="skill-name">{{armory_skill_name}}</span><span id="armory_skill_output" class="skill-output" data-class-inspectable="armory_calculation.size &gt; 0" data-event-mouseover="armory_skill_hover(true)" data-event-mousemove="armory_skill_hover(true)" data-event-mouseout="armory_skill_hover(false)">{{armory_skill_output}}</span></div>
<div class="muted">{{armory_skill_kind}}</div><div class="skill-costs">{{armory_costs}}</div><div class="restriction" data-if="armory_restriction != ''">{{armory_restriction}}</div>
</div>
<div class="resources"><div class="section-head">Resources</div><div class="resource-row"><div data-event-mouseover="armory_hover(-1, 0)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(-1, 0)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><button class="resource-value" data-event-click="armory_resource_expand(0)" data-class-highlighted="armory_resource_highlighted[0]"><span>Life</span><strong>{{armory_resources[0]}}</strong></button><div class="stat-detail" data-if="armory_resource_expanded[0]">{{armory_resource_details[0]}}</div></div><div data-event-mouseover="armory_hover(-1, 1)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(-1, 1)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><button class="resource-value" data-event-click="armory_resource_expand(1)" data-class-highlighted="armory_resource_highlighted[1]"><span>Mana</span><strong>{{armory_resources[1]}}</strong></button><div class="stat-detail" data-if="armory_resource_expanded[1]">{{armory_resource_details[1]}}</div></div><div data-event-mouseover="armory_hover(-1, 2)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(-1, 2)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><button class="resource-value" data-event-click="armory_resource_expand(2)" data-class-highlighted="armory_resource_highlighted[2]"><span>AG</span><strong>{{armory_resources[2]}}</strong></button><div class="stat-detail" data-if="armory_resource_expanded[2]">{{armory_resource_details[2]}}</div></div></div></div>
<div class="target">{{armory_target}}</div>
<button class="ratings-toggle" data-event-click="armory_ratings">{{armory_ratings ? 'Hide ratings' : 'Show raw ratings'}}</button>
<div class="categories"><div class="category" data-for="category : armory_categories" data-class-hidden="category.name == 'Ratings' &amp;&amp; !armory_ratings"><div class="section-head">{{category.name}}</div>
<div class="stat" data-for="row : category.rows" data-class-highlighted="row.highlighted">
<button class="stat-line" data-event-click="armory_expand(row.index)" data-event-mouseover="armory_hover(-1, row.index)" data-event-mouseout="armory_hover(-1, -1)" data-event-focus="armory_hover(-1, row.index)" data-event-blur="armory_hover(-1, -1)" tabindex="0"><span>{{row.label}}</span><span>{{row.value}}</span></button>
<div class="stat-detail" data-if="row.expanded">{{row.detail}}</div></div></div></div>
</div></div>
<div class="status"><span>{{armory_status}}</span><div class="character-links"><button data-event-click="chainfo_click_quest" data-attr-title="quest_tooltip">Quest</button><button data-event-click="chainfo_click_pet" data-attr-title="pet_tooltip">Pet</button><button data-event-click="chainfo_click_masterlevel" data-attrif-disabled="!master_level_enabled" data-attr-title="masterlevel_tooltip">Master</button></div><button data-if="armory_retry" data-event-click="armory_retry">Retry confirmation</button></div>
</div></div></body></rml>
