<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Command workbench</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="chat_command.rcss"/></head><body><div id="panel" data-model="chat_command" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-370 readable-text counter-scaled scaled-reference">{{title.text}}</span></div><button class="corner-close" data-event-click="chat_command_exit">×</button><div id="command_scroller" class="scroll-pane scaled-width-370 readable-text counter-scaled scaled-reference" data-event-mousescroll="chat_command_scroll"><div class="empty-note">{{empty_message.text}}</div>
<div data-if="page == 0"><button class="command-entry readable-text" data-for="r : all_command_rows" data-class-favourite="r.favourite" data-event-click="chat_command_hit(1, r.index)">{{r.text}}</button></div>
<div data-if="page == 1"><div class="description">{{description_text}}</div><div class="parameter cc-parameter" data-for="p, i : parameters"><div class="parameter-name" data-class-missing="p.missing">{{p.edited ? edited_parameter_label : p.label}}</div><button data-if="!p.edited" class="parameter-value readable-text" data-event-click="chat_command_hit(2, i)" data-class-placeholder="p.placeholder" data-class-edited="p.edited">{{p.value}}</button><input data-if="p.edited" data-event-keydown="chat_command_edit_key" class="text-field parameter-field" type="text" data-value="edit_value" data-style-font-size="text_px + 'px'"/></div><div class="local-actions"><button data-event-click="chat_command_hit(3, 0)" class="readable-text">{{favourite_action.text}}</button><button data-event-click="chat_command_hit(4, 0)" class="readable-text">{{save_action.text}}</button></div></div>
<div data-if="page == 2"><div class="template-row" data-for="r : all_template_rows"><button class="template-entry readable-text" data-event-click="chat_command_hit(5, r.index)">{{r.text}}</button><button class="template-remove" data-event-click="chat_command_hit(6, r.index)">×</button></div></div></div>
<div class="footer"><button id="btn_left" data-if="has_left_button" data-event-click="chat_command_left"><span class="native-text scaled-width-116 readable-text counter-scaled scaled-reference">{{left_text}}</span></button><button id="btn_right" data-if="has_right_button" data-event-click="chat_command_right"><span class="native-text scaled-width-116 readable-text counter-scaled scaled-reference">{{right_text}}</span></button><button id="btn_exit" data-event-click="chat_command_exit"><span class="native-text scaled-width-116 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></div></body></rml>
