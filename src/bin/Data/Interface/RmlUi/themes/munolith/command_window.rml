<rml>
<!-- bound-geometry: target marker follows the selected command -->
<head><link type="text/rcss" href="scaled_content.rcss"/><title>Munolith desk</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="list_desk_common.rcss"/></head><body><div id="panel" class="command-desk" data-model="command_window" data-compact-scale="1"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-180 counter-scaled scaled-reference" data-style-font-size="(title_text_px < 11 ? 11 : title_text_px) + 'px'">{{title_text}}</span></div><button class="corner-close" data-event-click="command_exit">×</button><div class="command-list scroll-pane scaled-width-180 scaled-height-252 counter-scaled scaled-reference" data-style-font-size="(title_text_px < 11 ? 11 : title_text_px) + 'px'"><button class="command-row" data-style-font-size="(b.label_text_px < 11 ? 11 : b.label_text_px) + 'px'" data-for="b : buttons" data-class-selected="b.selected" data-event-click="command_press(b.index)">{{b.label}}</button></div><button id="btn_exit" class="desk-close" data-event-click="command_exit"><span class="native-text scaled-width-180 counter-scaled scaled-reference" data-style-font-size="(title_text_px < 11 ? 11 : title_text_px) + 'px'">{{exit_tooltip}}</span></button><div id="target" data-if="target_visible" data-class-out-of-range="!target_in_range" data-style-left="target_left + 'px'" data-style-top="target_top + 'px'"><span class="native-text scaled-width-128 counter-scaled scaled-reference" data-style-font-size="(big_text_px < 11 ? 11 : big_text_px) + 'px'">{{target_name}}</span></div></div></body></rml>
