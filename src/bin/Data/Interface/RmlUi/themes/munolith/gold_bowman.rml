<rml><head><link type="text/rcss" href="event_item_target.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Golden Archer</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="golden_archer.rcss"/></head><body data-model="gold_bowman"><div id="panel" class="number-desk"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div><img id="entry_item" class="entry-item"/><div id="title"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[0].text}}</span></div><button class="corner-close" data-event-click="window_close">×</button><div class="archer-notes scroll-pane scaled-width-410 scaled-height-70 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'"><div class="archer-line">{{texts[1].text}}</div><div class="archer-line">{{texts[2].text}}</div><div class="archer-line">{{texts[3].text}}</div><div class="archer-line">{{texts[4].text}}</div></div><div class="number-notes scroll-pane scaled-width-410 scaled-height-70 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'"><div class="archer-line">{{texts[5].text}}</div><div class="archer-line">{{texts[6].text}}</div><div class="archer-line">{{texts[7].text}}</div><div class="archer-line">{{texts[8].text}}</div><div class="archer-line" data-if="texts.size > 9">{{texts[9].text}}</div></div><input id="serial_field" data-event-keydown="item_entry_key(1)" data-value="input_value" type="text" maxlength="12" class="text-field scaled-width-410 scaled-height-40 scaled-line-height-40 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'"/><button class="archer-register" data-class-locked="buttons[0].locked" data-attrif-disabled="buttons[0].locked" data-event-click="item_entry_press(0)"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{buttons[0].label}}</span></button><button class="desk-close" data-event-click="item_entry_press(1)"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{'Close'}}</span></button></div></body></rml>
