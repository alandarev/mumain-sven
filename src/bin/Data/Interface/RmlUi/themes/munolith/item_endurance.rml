<rml>
<!-- bound-geometry: the hovered item's tooltip follows the mouse (clamped to the screen edge) and the pet bars are lengths from their health -->

<head>
	<title>Item endurance (CItemEnduranceInfo)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="../legacy/item_endurance.rcss"/>
	<link type="text/rcss" href="item_endurance.rcss"/>
</head>
<body data-model="item_endurance">
    <div id="pet_safe_top"></div>
    <div id="warning_safe_top"></div>
	<!-- The item endurance HUD (CItemEnduranceInfo). Left column: the pet / summon HP frames under
	     the screen overlay transform (#pets, reference px inside). Right: the durability warning
	     icons of worn gear under the dock-right transform (#icons, reference px inside). Texts are
	     physical px at the native text size: the frames' names, the elf's arrow count line and the
	     hovered icon's tooltip. Behind the other documents of its context (the original drew it at
	     layer depth 3.5, under the panels). Takes no pointer events: C++ keeps the hit tests. -->
<div id="pets"><div id="pet_column">
<div id="arrows_row" data-if="arrows != ''"><span id="arrows" class="counter-scaled-xy" data-style-font-size="text_px + 'px'" data-style-line-height="line_height_px + 'px'">{{arrows}}</span></div>
<div class="pet" data-for="pet : pets"><div class="pet-fill"></div><div class="pet-frame"></div><div class="pet-track"></div><div class="pet-bar" data-style-width="pet.bar_width + 'px'"></div><div class="pet-name-box"><span class="pet-name counter-scaled-xy" data-style-font-size="text_px + 'px'" data-style-line-height="line_height_px + 'px'">{{pet.name}}</span></div></div>
</div></div>
<div id="icons"><div id="icon_column"><div data-for="icon : icons" data-attr-class="'icon cell-' + icon.cell"><div data-if="icon.image != ''" data-attr-class="'icon-art icon-art--' + icon.image"></div><div data-attr-class="'icon-tint icon-tint--' + icon.band + (icon.tint_half == '' ? '' : ' half-' + icon.tint_half)"></div></div></div></div>

	<div class="text-row" data-if="tooltip != ''" data-style-left="(tooltip_centre_x - 300) + 'px'"
	     data-style-top="tooltip_top + 'px'">
		<span data-attr-class="'durability-tip tooltip tooltip--' + tooltip_band" data-style-font-size="bold_text_px + 'px'"
		      data-style-line-height="bold_line_height_px + 'px'">{{tooltip}}</span>
	</div>
</body>
</rml>
