<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Julia</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="market_travel.rcss"/></head><body data-model="united_market_place"><div id="panel"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{title}}</span></div><button class="corner-close" data-event-click="market_exit">×</button><div class="market-notes scroll-pane scaled-width-410 scaled-height-245 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'"><div class="travel-line" data-for="line : lines" data-if="line != ''">{{line}}</div></div><button id="warp" data-class-locked="warp_locked" data-attrif-disabled="warp_locked" data-event-click="market_warp"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{warp_text}}</span></button><button class="desk-close" data-event-click="market_exit"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{exit_tooltip}}</span></button></div></body></rml>
