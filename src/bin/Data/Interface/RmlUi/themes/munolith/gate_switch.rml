<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Castle service</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="siege_service_common.rcss"/><link type="text/rcss" href="gate_state.rcss"/></head><body><div id="panel" class="gate-switch-desk" data-model="gate_switch" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-330 readable-text counter-scaled scaled-reference">{{title}}</span></div><button class="corner-close" data-event-click="gate_switch_exit">×</button><div id="gate" data-class-opened="gate_opened"/><div class="gate-content scroll-pane scaled-width-155 scaled-height-210 readable-text counter-scaled scaled-reference"> <div class="service-line">{{line1}}</div><div class="service-line">{{line2}}</div><div class="service-line warning">{{warning}}</div></div><button class="gate-action" data-event-click="gate_switch_toggle"><span class="native-text scaled-width-145 readable-text counter-scaled scaled-reference">{{button_text}}</span></button><button class="desk-close" data-event-click="gate_switch_exit"><span class="native-text scaled-width-330 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></body></rml>
