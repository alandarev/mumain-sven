#panel { width: 340dp; height: 150dp; font-family: "DejaVu Sans"; color: #c6cbb4; background-color: transparent; border-width: 0; }
.frame-accent { display: none; }.prompt-title { color: #d7b864; }.prompt-body { color: #c6cbb4; }
.btn { color: #ded1ac; background-color: #172018; border: 1dp #6b6646; decorator: none; }.btn:hover, .btn:active { background-color: #35452a; border-color: #b8a563; decorator: none; }
