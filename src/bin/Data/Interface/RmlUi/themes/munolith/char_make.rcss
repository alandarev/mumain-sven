body { pointer-events: none; }
#panel { position: absolute; width: 454px; height: 406px; font-family: "DejaVu Sans"; font-size: 12px; color: #c6cbb4; pointer-events: none; }
.side-panel { position: absolute; box-sizing: border-box; background-color: #10190fee; border: 1px #77734a; pointer-events: none; }
#attributes_panel { left: 346px; top: 0; width: 108px; height: 120px; }
#class_panel { left: 346px; top: 122px; width: 108px; height: 202px; }
#identity_strip { left: 0; top: 317px; width: 346px; height: 38px; }
.panel-kicker { display: block; position: absolute; left: 350px; width: 100px; color: #d7b864; text-align: center; font-size: 11px; pointer-events: none; }
.panel-kicker-attributes { top: 5px; }
.panel-kicker-class { top: 113px; display: none; }
#stat_panel { left: 346px; top: 24px; }
.stat-panel, .desc-panel { position: absolute; }
.stat-bg { display: none; }
.stat-row { position: absolute; left: 6px; width: 96px; height: 16px; }
.stat-row-0 { top: 3px; }.stat-row-1 { top: 19px; }.stat-row-2 { top: 35px; }.stat-row-3 { top: 51px; }.stat-row-4 { top: 67px; }
.stat-row-4.hidden { display: none; }
.stat-label { display: block; width: 74px; font-size: 11px; }
.stat-value { position: absolute; left: 74px; width: 22px; top: 0; text-align: right; color: #d7b864; font-size: 11px; }
.job-btn { position: absolute; left: 348px; width: 104px; height: 26px; box-sizing: border-box; color: #c6cbb4; background-color: #172018; border-bottom: 1px #394331; font-size: 12px; line-height: 26px; text-align: center; pointer-events: auto; cursor: pointer; }
.job-btn[job="wizard"] { top: 131px; }.job-btn[job="knight"] { top: 157px; }.job-btn[job="elf"] { top: 183px; }.job-btn[job="summoner"] { top: 209px; }.job-btn[job="rage-fighter"] { top: 246px; }.job-btn[job="dark"] { top: 272px; }.job-btn[job="dark-lord"] { top: 298px; }
.job-btn.checked { color: #eff0c4; background-color: #40522c; border-color: #b8a563; }
.job-btn:hover { background-color: #35452a; }
#desc_panel { left: 0; top: 355px; width: 454px; height: 51px; }
.desc-bg { position: absolute; left: 0; top: 0; width: 454px; height: 51px; box-sizing: border-box; background-color: #10190fee; border: 1px #77734a; }
.desc-title { display: block; position: absolute; left: 10px; right: 10px; top: 3px; color: #d7b864; font-size: 11px; }
.desc-line { position: absolute; left: 10px; right: 10px; white-space: normal; font-size: 11px; }
.desc-line-1 { top: 19px; }.desc-line-2 { top: 34px; }
.input-frame { display: none; }
.input-label { display: block; position: absolute; left: 12px; top: 328px; color: #d7b864; font-size: 12px; }
.char-make-name-field { position: absolute; left: 63px; top: 325px; width: 275px; height: 23px; box-sizing: border-box; padding: 2px 5px; font-family: "DejaVu Sans"; font-size: 12px; color: #ded1ac; background-color: #172018; border: 1px #545139; pointer-events: auto; }
.btn { position: absolute; top: 325px; width: 54px; height: 30px; line-height: 30px; text-align: center; font-size: 12px; border-width: 1px; }
#btn_ok { left: 346px; }#btn_cancel { left: 400px; }

.creation-blocker { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: auto; }

#preview { position: absolute; left: 0; top: 0; width: 346px; height: 317px; pointer-events: none; }
#preview.awaiting-frame { visibility: hidden; }
