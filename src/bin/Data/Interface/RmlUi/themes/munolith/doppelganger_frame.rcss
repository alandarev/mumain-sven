@spritesheet frame-hero-sheet { src: "../../../Double_Baricon04.tga"; frame-hero: 0px 0px 9px 8px; }
@spritesheet frame-member-sheet { src: "../../../Double_Baricon01.tga"; frame-member: 0px 0px 9px 8px; }
body { pointer-events: none; }
.screen { position: absolute; left: 0; top: 0; width: 640px; height: 480px; transform-origin: left top; pointer-events: none; }
#panel { position: absolute; width: 227px; height: 87px; font-family: "DejaVu Sans"; pointer-events: none; }
#back { position: absolute; left: 0; top: 0; width: 227px; height: 87px; box-sizing: border-box; background-color: #10190fee; border: 1px #77734a; }
.event-name, .frame-text { display: block; position: absolute; left: 8px; transform-origin: left top; white-space: nowrap; text-align: center; line-height: 1.15em; pointer-events: none; }
.event-name { top: 5px; color: #d7b864; }
#dg_passed { top: 25px; color: #ded1ac; }
#dg_passed.passed-one { color: #efa15e; }
#dg_passed.passed-several { color: #ff5b5b; }
#dg_time_label { top: 49px; color: #c6cbb4; }
#dg_time { left: 105px; top: 43px; color: #ded1ac; font-weight: bold; }
.bar { position: absolute; top: 78px; height: 7px; }
#icewalker { position: absolute; top: 77px; width: 13px; height: 7px; }
.marker { position: absolute; top: 79px; width: 9px; height: 8px; decorator: image(frame-member); }
.marker.hero { decorator: image(frame-hero); }

.hud-width-211 { width: calc(211px * var(--root-scale)); }
.hud-width-105 { width: calc(105px * var(--root-scale)); }
.hud-width-114 { width: calc(114px * var(--root-scale)); }
