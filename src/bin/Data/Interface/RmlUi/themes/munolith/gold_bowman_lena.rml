<rml><head><link type="text/rcss" href="event_item_target.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Golden Archer</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="golden_archer.rcss"/></head><body data-model="gold_bowman_lena"><div id="panel" class="rena-desk"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div><img id="entry_item" class="entry-item"/><div id="title"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[0].text}}</span></div><button class="corner-close" data-event-click="window_close">×</button><div class="archer-notes scroll-pane scaled-width-410 scaled-height-60 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'"><div class="archer-line">{{texts[1].text}}</div><div class="archer-line">{{texts[2].text}}</div><div class="archer-line">{{texts[3].text}}</div><div class="archer-line">{{texts[8].text}}</div><div class="archer-line">{{texts[9].text}}</div></div><div class="collected-label"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[4].text}}</span></div><div class="collected-count"><span class="native-text scaled-width-145 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[5].text}}</span></div><div class="registered-label"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[6].text}}</span></div><div class="registered-count"><span class="native-text scaled-width-145 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{texts[7].text}}</span></div><div id="rena_collected" class="entry-item-box"/><div id="rena_registered" class="entry-item-box"/><button class="archer-register" data-class-locked="buttons[0].locked" data-attrif-disabled="buttons[0].locked" data-event-click="item_entry_press(0)"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{buttons[0].label}}</span></button><button class="desk-close" data-event-click="item_entry_press(1)"><span class="native-text scaled-width-410 scaled-reference counter-scaled" data-style-font-size="(text_px < 14 ? 14 : (text_px > 20 ? 20 : text_px)) + 'px'">{{'Close'}}</span></button></div></body></rml>
