<div class="offer-grid partner"><div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div></div>
<div class="offer-grid local"><div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div>
<div class="grid-row"><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/><div class="cell"/></div></div>
</div></body></rml>
