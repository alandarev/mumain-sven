<rml>
<!-- bound-geometry: a map item's bars are lengths, RenderCastleItem()'s own gauge widths. The tab positions are in each theme's RCSS -->
<head><link type="text/rcss" href="scaled_content.rcss"/><title>Castle desk</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_map.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/></head><body><div id="panel" class="management-desk" data-model="castle_window" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-450 readable-text counter-scaled scaled-reference">{{title.text}}</span></div><button class="corner-close" data-event-click="senatus_button(11)">×</button><div class="tabs"><button data-for="t, i : tabs" data-class-selected="t.selected" data-event-click="senatus_tab(i)"><span class="native-text scaled-width-106 readable-text counter-scaled scaled-reference">{{t.label}}</span></button></div><div class="defense-page" data-if="active_tab == 0 || active_tab == 1" data-class-statue="statue_page"><div class="map-title"><span class="native-text scaled-width-200 readable-text counter-scaled scaled-reference">{{map_title.text}}</span></div><div class="castle-map"><div class="castle-map-art"/><div class="castle-map-item" data-for="it, i : map_items" data-class-statue="it.statue" data-class-current="it.current" data-class-item-0="i == 0" data-class-item-1="i == 1" data-class-item-2="i == 2" data-class-item-3="i == 3" data-class-item-4="i == 4" data-class-item-5="i == 5" data-event-click="senatus_pick(i)"><div class="castle-icon"/><div class="bars" data-if="it.live"><div class="hp-track" data-style-width="it.hp_width + 'px'"/><div class="hp-fill" data-style-width="it.hp_fill_width + 'px'"/><div class="defense-fill" data-style-width="it.defense_width + 'px'"/><div class="recover-fill" data-if="it.statue" data-style-width="it.recover_width + 'px'"/></div></div></div><div class="map-actions scaled-width-200 scaled-height-24 counter-scaled readable-text scaled-reference"><button data-if="buy_button.shown" data-class-locked="buy_button.locked" data-attrif-disabled="buy_button.locked" data-event-click="senatus_button(0)" class="readable-text">{{buy_button.label}}</button><button data-if="repair_button.shown" data-class-locked="repair_button.locked" data-attrif-disabled="repair_button.locked" data-event-click="senatus_button(1)" class="readable-text">{{repair_button.label}}</button></div><div class="defense-details scroll-pane scaled-width-230 scaled-height-246 readable-text counter-scaled scaled-reference"><div data-if="item_live"><div class="detail-line current-stat">{{stat_hp.text}}</div><div class="detail-line current-stat">{{stat_defense.text}}</div><div class="detail-line current-stat" data-if="statue_page">{{stat_recover.text}}</div><div class="section-title">{{improve_title.text}}</div><div class="upgrade-row"><div>{{next_hp.text}}</div><button data-if="hp_button.shown" data-class-locked="hp_button.locked" data-attrif-disabled="hp_button.locked" data-event-click="senatus_button(2)" class="readable-text">{{hp_button.label}}</button></div><div class="upgrade-row"><div>{{next_defense.text}}</div><button data-if="defense_button.shown" data-class-locked="defense_button.locked" data-attrif-disabled="defense_button.locked" data-event-click="senatus_button(3)" class="readable-text">{{defense_button.label}}</button></div><div class="upgrade-row" data-if="statue_page"><div>{{next_recover.text}}</div><button data-if="recover_button.shown" data-class-locked="recover_button.locked" data-attrif-disabled="recover_button.locked" data-event-click="senatus_button(4)" class="readable-text">{{recover_button.label}}</button></div></div></div></div><div class="tax-page" data-if="active_tab == 2"><div class="tax-content scroll-pane scaled-width-450 scaled-height-228 readable-text counter-scaled scaled-reference"><div class="section-title">{{tax_title.text}}</div><div class="rate-row"><div>{{chaos_rate.text}}</div><button data-event-click="senatus_button(8)" class="readable-text">−</button><button data-event-click="senatus_button(7)" class="readable-text">+</button></div><div class="rate-row"><div>{{store_rate.text}}</div><button data-event-click="senatus_button(10)" class="readable-text">−</button><button data-event-click="senatus_button(9)" class="readable-text">+</button></div><div class="money-row"><div>{{zen_label.text}}</div><div>{{castle_money.text}}</div></div><div class="tax-rules"><div>{{note1.text}}</div><div>{{note2.text}}</div><div>{{note3.text}}</div><div>{{rule1.text}}</div><div>{{rule2.text}}</div><div>{{rule3.text}}</div><div>{{rule4.text}}</div><div>{{rule5.text}}</div><div>{{rule6.text}}</div><div>{{footer1.text}}</div><div>{{footer2.text}}</div><div>{{footer3.text}}</div></div></div><div class="tax-actions scaled-width-450 scaled-height-24 counter-scaled readable-text scaled-reference"><button data-if="apply_button.shown" data-class-locked="apply_button.locked" data-attrif-disabled="apply_button.locked" data-event-click="senatus_button(5)" class="readable-text">{{apply_button.label}}</button><button data-if="withdraw_button.shown" data-class-locked="withdraw_button.locked" data-attrif-disabled="withdraw_button.locked" data-event-click="senatus_button(6)" class="readable-text">{{withdraw_button.label}}</button></div></div><button class="desk-close" data-event-click="senatus_button(11)"><span class="native-text scaled-width-450 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></body></rml>
