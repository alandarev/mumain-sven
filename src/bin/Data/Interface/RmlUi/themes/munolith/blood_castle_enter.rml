<rml><head><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Event entry</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="event_desk_common.rcss"/></head><body data-model="blood_castle_enter"><div id="panel" class="" data-compact-scale="1.2"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-151 counter-scaled scaled-reference" data-style-font-size="((text_px < 11 ? 11 : text_px) * 1.1) + 'px'">Blood Castle</span></div><button class="corner-close" data-event-click="entry_exit">×</button><div class="intro scroll-pane scaled-width-160 scaled-height-78 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'"><div class="entry-npc">{{title_text}}</div><div class="description-line" data-for="line : lines">{{line.text}}</div></div><div class="level-list scroll-pane"><button class="level-btn" data-for="b, i : buttons" data-class-enabled="b.enabled" data-class-locked="!b.enabled" data-attrif-disabled="!b.enabled" data-event-click="entry_press(i)"><span class="native-text scaled-width-149 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{b.label}}</span></button></div><div class="actions"><button id="btn_exit" data-event-click="entry_exit"><span class="native-text scaled-width-160 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{exit_tooltip}}</span></button></div></div></body></rml>
