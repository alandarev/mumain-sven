#panel, #bg_root { width: 190px; height: 350px; }
#panel { pointer-events: none; }
.native-text { display: inline-block; transform-origin: left top; white-space: nowrap; }
#title { position: absolute; top: 8px; left: 31px; right: 39px; height: 15px; text-align: center; color: #d7b864; }
button { display: inline-block; height: 20px; box-sizing: border-box; font-family: "DejaVu Sans"; font-size: 8px; color: #ded1ac; background-color: #343422; border: 1px #6b6646; pointer-events: auto; padding: 2px 4px; }
button:hover { background-color: #51482b; border-color: #c9a65c; }
#btn_corner_close { position: absolute; right: 5px; top: 3px; width: 10px; height: 12px; padding: 0; border-width: 0; background-color: transparent; color: #d7b864; font-size: 9px; }
#your_guild_name { position: absolute; left: 15px; top: 30px; width: 160px; height: 12px; color: #a9a48e; }
#your_id_text { position: absolute; left: 34px; top: 44px; width: 141px; height: 12px; color: #ded1ac; }
#your_level_text { position: absolute; left: 34px; top: 56px; width: 141px; height: 10px; color: #a9a48e; }
#my_id_text { position: absolute; left: 15px; top: 191px; width: 160px; height: 12px; color: #ded1ac; }
.native-anchor, .offer-grid, .ready-overlay { position: absolute; left: 15px; width: 160px; height: 80px; pointer-events: none; }
#partner_grid, .offer-grid.partner, .ready-overlay.partner { top: 70px; }
#item_grid, .offer-grid.local, .ready-overlay.local { top: 208px; }
.grid-row { display: flex; width: 160px; height: 20px; }
.cell { width: 20px; height: 20px; box-sizing: border-box; border: 1px #373d2d; background-color: #10170dee; }
.ready-overlay { background-color: #36b54d45; border: 1px #79d281a0; box-sizing: border-box; }
.zen-strip { position: absolute; left: 15px; width: 160px; height: 22px; box-sizing: border-box; border: 1px #545139; background-color: #181d12; color: #d7b864; padding: 4px 5px; font-size: 8px; }
.zen-strip.partner { top: 155px; }
.zen-strip.local { top: 293px; }
.zen-strip.ready { border-color: #79d281; background-color: #244e26; }
.zen-label { display: inline-block; width: 24px; }
.zen-value { position: absolute; right: 5px; top: 4px; text-align: right; }
#divider { position: absolute; left: 15px; right: 15px; top: 183px; height: 1px; background-color: #545139; }
.trade-actions { position: absolute; left: 15px; top: 321px; width: 160px; height: 20px; display: flex; gap: 6px; }
#btn_exit { width: 62px; }
#my_confirm { width: 92px; }
#my_confirm.ready { background-color: #244e26; border-color: #79d281; }
#my_confirm.waiting { color: #a9a48e; background-color: #24271e; border-color: #545139; }
.item-warning-badge { position: absolute; text-align: center; color: #ffbd69; background-color: #352015; pointer-events: none; }

#item_grid_counts { left: 15px; top: 208px; width: 160px; height: 80px; }
#partner_grid_counts { left: 15px; top: 70px; width: 160px; height: 80px; }
.item-warning-badge { left: calc(var(--warning-x, 0) * 1px); top: calc(var(--warning-y, 0) * 1px); width: calc(var(--warning-width, 0) * 1px * var(--root-scale)); }
