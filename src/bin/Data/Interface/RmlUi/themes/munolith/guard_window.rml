<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Castle desk</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/></head><body><div id="panel" class="siege-desk" data-model="guard_window" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-350 readable-text counter-scaled scaled-reference">{{title.text}}</span></div><button class="corner-close" data-event-click="guard_button(3)">×</button><div class="owner-summary"><span class="native-text scaled-width-350 readable-text counter-scaled scaled-reference">{{owner_master.text}}</span><span class="native-text scaled-width-350 readable-text counter-scaled scaled-reference">{{owner_guild.text}}</span></div><div class="tabs"><button data-for="t, i : tabs" data-class-selected="t.selected" data-event-click="guard_tab(i)"><span class="native-text scaled-width-110 readable-text counter-scaled scaled-reference">{{t.label}}</span></button></div><div class="guard-content scroll-pane scaled-width-350 scaled-height-199 readable-text counter-scaled scaled-reference"><div data-if="active_tab == 0"><div class="detail-line">{{status_period.text}}</div><div class="detail-line">{{status_start.text}}</div><div class="detail-line">{{status_end.text}}</div><div class="detail-line">{{status_expected_label.text}}</div><div class="detail-line">{{status_expected_time.text}}</div><div class="detail-line">{{status_next_stage.text}}</div></div><div data-if="active_tab == 1"><div class="detail-line">{{register_message.text}}</div><div class="detail-line">{{register_message2.text}}</div><div class="detail-line">{{register_acquired.text}}</div><div class="detail-line">{{register_registered.text}}</div></div><div data-if="active_tab == 2"><div class="detail-line">{{list_message.text}}</div></div></div><div class="guild-table kind-1 readable-text" data-if="list_kind == 1"><div class="table-head"><div class="col-name"><span class="native-text scaled-width-85 readable-text counter-scaled scaled-reference">{{header_name}}</span></div><div class="col-marks"><span class="native-text scaled-width-85 readable-text counter-scaled scaled-reference">{{header_mark_count}}</span></div><div class="col-state"><span class="native-text scaled-width-85 readable-text counter-scaled scaled-reference">{{header_state}}</span></div><div class="col-order"><span class="native-text scaled-width-85 readable-text counter-scaled scaled-reference">{{header_order}}</span></div></div><div id="guard_declare_list" class="guild-rows scroll-pane scaled-width-350 scaled-height-155 readable-text counter-scaled scaled-reference"><div class="guild-row" data-for="r : declare_rows" data-class-selected="r.selected" data-event-click="guard_declare_select(r.name)"><div class="col-name">{{r.name}}</div><div class="col-marks">{{r.mark_count}}</div><div class="col-state">{{r.state}}</div><div class="col-order">{{r.order}}</div></div></div></div><div class="guild-table kind-2 readable-text" data-if="list_kind == 2"><div class="table-head"><div class="col-name"><span class="native-text scaled-width-110 readable-text counter-scaled scaled-reference">{{header_name}}</span></div><div class="col-side"><span class="native-text scaled-width-110 readable-text counter-scaled scaled-reference">{{header_side}}</span></div><div class="col-involvement"><span class="native-text scaled-width-110 readable-text counter-scaled scaled-reference">{{header_involvement}}</span></div></div><div id="guard_siege_list" class="guild-rows scroll-pane scaled-width-350 scaled-height-155 readable-text counter-scaled scaled-reference"><div class="guild-row" data-for="r : siege_rows" data-class-selected="r.selected" data-class-defending="r.defending" data-event-click="guard_siege_select(r.name)"><div class="col-name">{{r.name}}</div><div class="col-side">{{r.side}}</div><div class="col-involvement">{{r.involvement}}</div></div></div></div><div class="guild-score" data-if="list_kind == 2"><span class="native-text scaled-width-65 readable-text counter-scaled scaled-reference">{{score_label}}</span><span class="native-text scaled-width-270 readable-text counter-scaled scaled-reference">{{score_value}}</span></div><div class="guard-actions"><button data-if="proclaim_button.shown" data-class-locked="proclaim_button.locked" data-attrif-disabled="proclaim_button.locked" data-event-click="guard_button(0)"><span class="native-text scaled-width-165 readable-text counter-scaled scaled-reference">{{proclaim_button.label}}</span></button><button data-if="register_button.shown" data-class-locked="register_button.locked" data-attrif-disabled="register_button.locked" data-event-click="guard_button(1)"><span class="native-text scaled-width-165 readable-text counter-scaled scaled-reference">{{register_button.label}}</span></button><button data-if="give_up_button.shown" data-class-locked="give_up_button.locked" data-attrif-disabled="give_up_button.locked" data-event-click="guard_button(2)"><span class="native-text scaled-width-165 readable-text counter-scaled scaled-reference">{{give_up_button.label}}</span></button></div><button class="desk-close" data-event-click="guard_button(3)"><span class="native-text scaled-width-350 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></body></rml>
