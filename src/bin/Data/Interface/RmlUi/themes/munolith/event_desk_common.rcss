#panel, #bg_root { width: 190px; height: 350px; }
#panel { pointer-events: auto; }
#title { position: absolute; left: 15px; right: 24px; top: 8px; height: 17px; color: #d7b864; text-align: center; overflow: hidden; }
.native-text { display: inline-block; transform-origin: left top; pointer-events: none; white-space: normal; }
#title .native-text { white-space: nowrap; }
button { box-sizing: border-box; font-family: "DejaVu Sans"; font-size: 8px; padding: 3px 4px; color: #ded1ac; background-color: #343422; border: 1px #6b6646; pointer-events: auto; }
button:hover { background-color: #51482b; border-color: #c9a65c; }
button:disabled, button.locked { color: #7e8878; background-color: #172018; border-color: #384436; }
.corner-close { position: absolute; right: 5px; top: 3px; width: 10px; height: 12px; padding: 0; border-width: 0; background-color: transparent; color: #d7b864; }
.intro { position: absolute; left: 15px; top: 36px; width: 160px; height: 78px; overflow: hidden auto; color: #bbc1af; }
.intro-content { transform-origin: left top; }
.description-line { display: block; line-height: 1.3em; }
.level-list { position: absolute; left: 15px; top: 118px; width: 160px; height: 192px; overflow: hidden auto; }
.level-btn { position: relative; display: block; width: 155px; height: 21px; margin-bottom: 3px; padding: 0; }
.level-btn.enabled { background-color: #263325; border-color: #a6a46a; color: #dce5bf; }
.level-btn .native-text { position: absolute; left: 3px; top: 4px; white-space: nowrap; }
.actions { position: absolute; left: 15px; right: 15px; bottom: 14px; height: 21px; display: flex; gap: 6px; }
.actions button { flex: 1 1 0; height: 21px; padding: 2px 3px; }
.actions .native-text { white-space: nowrap; }
.scroll-pane scrollbarvertical { width: 5px; }
.scroll-pane scrollbarvertical slidertrack { decorator: none; background-color: #10170d; }
.scroll-pane scrollbarvertical sliderbar { decorator: none; background-color: #766b45; min-height: 15px; height: auto; }
.scroll-pane scrollbarvertical sliderarrowdec, .scroll-pane scrollbarvertical sliderarrowinc { decorator: none; height: 0; }
#panel.ticket-desk, #bg_root.ticket-desk { height: 320px; }
.ticket-descriptions { position: absolute; left: 15px; right: 15px; top: 36px; height: 72px; overflow: hidden auto; }
.ticket-well { position: absolute; left: 15px; top: 114px; width: 160px; height: 45px; border: 1px #414d3d; box-sizing: border-box; background-color: #0c170daa; }
.ticket-name { position: absolute; left: 15px; top: 164px; width: 160px; height: 20px; color: #d7b864; text-align: center; }
.ticket-details { position: absolute; left: 15px; top: 192px; width: 160px; height: 84px; overflow: hidden auto; border-top: 1px #545139; padding-top: 5px; box-sizing: border-box; }
.ticket-description, .ticket-detail { display: block; }
.ticket-details .native-text { display: block; }
#panel.ticket-desk.guardian, #bg_root.ticket-desk.guardian { height: 350px; }
.guardian .ticket-details { height: 114px; }
.ticket-detail.warning { color: #e1b280; margin-bottom: 4px; }
#panel.temple-desk, #bg_root.temple-desk { width: 230px; height: 300px; }
.temple-question { position: absolute; left: 15px; top: 35px; width: 200px; height: 40px; }
.temple-current { position: absolute; left: 15px; top: 78px; width: 200px; height: 20px; color: #d7b864; }
.temple-bands { position: absolute; left: 15px; top: 103px; width: 200px; }
.temple-band { box-sizing: border-box; height: 20px; margin-bottom: 3px; padding: 3px 4px; background-color: #101d15; color: #82917e; border: 1px #374736; }
.temple-band.hero { background-color: #2b3923; color: #e2e8bf; border-color: #b8a563; }
.temple-members { position: absolute; left: 15px; top: 246px; width: 200px; height: 17px; color: #c8c9ad; }
.temple-notice { position: absolute; left: 15px; top: 103px; width: 200px; color: #e1b280; }
#panel.kanturu-desk, #bg_root.kanturu-desk { width: 230px; height: 267px; }
.kanturu-content { position: absolute; left: 15px; top: 38px; width: 200px; height: 178px; overflow: hidden auto; }
.kanturu-line { display: block; margin-bottom: 8px; }
.tone-subject { color: #d7b864; }
.tone-state { color: #c4d5ac; }
.tone-note { color: #bbc1af; }
.hidden { display: none; }

button.locked { pointer-events: none; }

.level-btn .native-text { white-space: normal; }
.temple-bands { height: 137px; overflow: hidden auto; }
.ticket-description, .ticket-detail { line-height: 1.3em; }
.ticket-detail { margin-bottom: 4px; }
.ticket-details { padding-top: 5px; }
.kanturu-line { line-height: 1.3em; margin-bottom: 8px; }
.entry-npc { color: #d7b864; margin-bottom: 5px; line-height: 1.3em; }
.intro, .ticket-descriptions, .ticket-details, .kanturu-content { transform-origin: left top; }
.description-line, .ticket-description, .ticket-detail, .kanturu-line { white-space: normal; }

.level-btn { height: 21px; }
#panel.compact-scale .level-btn { height: calc(34px / var(--root-scale)); }

.level-btn { height: 21px; }
#panel.compact-scale .level-btn { height: calc(34px / var(--root-scale)); }

.temple-band { height: 20px; }
#panel.compact-scale .temple-band { height: calc(32px / var(--root-scale)); }
