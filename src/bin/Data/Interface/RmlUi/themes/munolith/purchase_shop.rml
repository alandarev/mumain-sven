<rml><head><link type="text/rcss" href="../legacy/item_grid.rcss"/><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="native_items.rcss"/><title>Personal Store</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="personal_shop_common.rcss"/></head><body data-model="purchase_shop"><div id="panel"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div><div id="title"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{title}}</span></div><button class="corner-close" data-event-click="purchase_shop_exit_click">×</button><div class="shop-name shop-nameplate" id="shop_owner_text">{{shop_owner_text}}</div><div id="item_grid" class="native-anchor item-grid"><div class="item-grid-cells"><div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div><img id="item_view" class="item-view"/><div id="item_grid_counts" class="item-grid-counts"><div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div><div class="notice"><div class="notice-heading">{{warning_label}}</div><div class="notice-line">{{selling_price_line}}</div><div class="notice-line">{{verify_line}}</div><div class="notice-line">{{already_in_store_line}}</div><div class="notice-line">{{cancel_purchased_line}}</div><div class="notice-line">{{cant_be_returned_line}}</div><div class="notice-ending">{{all_item_trading_line}}</div><div class="notice-line">{{zen_only_line}}</div></div><div class="actions"><button id="btn_exit" data-event-click="purchase_shop_exit_click">Close</button></div></div></body></rml>
