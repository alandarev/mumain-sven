.screen { position: absolute; left: 0; top: 0; width: 640px; height: 480px; transform-origin: left top; pointer-events: none; }
#panel.roster { position: absolute; box-sizing: border-box; width: 96px; margin-left: -39px;  background-color: #10190fee; border: 1px #666747; pointer-events: auto; }
.roster-heading { display: block; height: 20px; color: #d7b864; border-bottom: 1px #545139; text-align: center; }
.viewer { display: block; height: 18px; padding-left: 3px; color: #c6cbb4; border-bottom: 1px #29382b; }
.roster-heading span, .viewer span { display: block; transform-origin: left top; font-family: "DejaVu Sans"; white-space: nowrap; pointer-events: none; }

.hud-width-96 { width: calc(96px * var(--root-scale)); }
.hud-width-90 { width: calc(90px * var(--root-scale)); }

#panel.roster { height: auto; }
