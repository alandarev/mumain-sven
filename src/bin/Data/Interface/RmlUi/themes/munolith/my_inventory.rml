<rml><head><title>Inventory</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="../legacy/item_grid.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="my_inventory_bg.rcss"/><link type="text/rcss" href="my_inventory.rcss"/></head>
<body data-model="my_inventory"><div id="panel" data-compact-scale="1.2" data-class-expanded-one="owned_extensions == 1" data-class-expanded-two="owned_extensions == 2">
<div class="stone"></div><div class="shade"></div>
<div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div>

<div id="title"><span class="native-text title-text counter-scaled" data-style-font-size="(text_px * 1.15) + 'px'">{{title}}</span></div>
<button class="close" title="Close Inventory" data-event-click="my_inventory_exit_click">×</button>
<div class="option-labels counter-scaled" data-style-font-size="text_px + 'px'">
<span id="set_option" class="option-label" data-class-active="set_option_active" data-event-mouseover="my_inventory_set_option_hover" data-event-mouseout="my_inventory_set_option_unhover">{{set_option_label}}</span>
<span id="socket_option" class="option-label" data-class-active="socket_option_active" data-event-mouseover="my_inventory_socket_option_hover" data-event-mouseout="my_inventory_socket_option_unhover">{{socket_option_label}}</span>
</div><div id="option_tooltip_anchor" class="native-anchor"></div>
<span class="capacity native-text counter-scaled" data-style-font-size="text_px + 'px'">{{capacity_text}}</span>
<button id="btn_myshop" class="shop-entry" data-class-hidden="!myshop_visible" data-class-locked="myshop_locked" data-class-active="!myshop_mode_open" data-event-click="my_inventory_myshop_click" data-attr-title="myshop_tooltip"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">Store</span></button>
<div class="grid"><div class="grid-row" data-for="row : rows" data-class-partition="row == 8 || row == 12"><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div></div></div>
<div id="item_grid" class="native-anchor item-grid themed-grid"><div class="merchant-delivery" data-if="delivery_visible" data-style---delivery-column="delivery_column" data-style---delivery-row="delivery_row" data-style---delivery-width="delivery_width" data-style---delivery-height="delivery_height"></div><div class="item-grid-cells"><div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div>
<div id="item_grid_extension_1" class="native-anchor item-grid themed-grid" data-if="owned_extensions >= 1"><div class="item-grid-cells"><div data-for="c : grid_cells_extension_1" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div>
<div id="item_grid_extension_2" class="native-anchor item-grid themed-grid" data-if="owned_extensions >= 2"><div class="item-grid-cells"><div data-for="c : grid_cells_extension_2" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div>
<img id="item_view" class="item-view"/>
<div id="item_grid_counts" class="item-grid-counts"><div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div>
<div id="item_grid_extension_1_counts" class="item-grid-counts" data-if="owned_extensions >= 1"><div class="item-count" data-for="c : grid_cells_extension_1"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div>
<div id="item_grid_extension_2_counts" class="item-grid-counts" data-if="owned_extensions >= 2"><div class="item-count" data-for="c : grid_cells_extension_2"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div>

<div class="footer">
<div class="money counter-scaled"><span class="amount native-text" data-style-font-size="text_px + 'px'">{{gold_text}}</span><span class="zen native-text" data-class-gained="gold_gained" data-style-font-size="text_px + 'px'">{{gold_label}}</span></div>
<div class="inventory-actions"><button id="btn_repair" class="repair" data-class-active="repair_active" data-class-hidden="!repair_visible" data-event-click="my_inventory_repair_click" title="Repair [L] · Click an item · Escape to leave"/>
<div class="tooltip native-text counter-scaled" data-style-font-size="text_px + 'px'">{{repair_active ? 'Repair active · Esc to leave' : 'Repair [L]'}}</div>
<button class="expand" data-if="expansion_visible" data-event-click="my_inventory_expand_click"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">Expand +32</span></button>
<button class="expand" data-if="overflow_visible" data-event-click="my_inventory_overflow_click" title="Access items in your historical extra capacity"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">Extra items</span></button>
</div></div></div></body></rml>
