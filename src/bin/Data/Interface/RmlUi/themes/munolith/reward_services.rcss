#panel.coin-registration, #panel.coin-exchange, #bg_root.coin-registration, #bg_root.coin-exchange { width: 280px; height: 340px; }
#panel.lucky-item-counter, #bg_root.lucky-item-counter { width: 190px; height: 400px; }
#panel { pointer-events: auto; }
#bg_root { position: absolute; pointer-events: none; transform-origin: left top; }
#title { position: absolute; left: 15px; right: 15px; top: 8px; height: 19px; text-align: center; color: #d7b864; }
.reward-line { display: block; white-space: normal; line-height: 1.4em; margin-bottom: 6px; color: #c6cbb4; }
.reward-line.warning { color: #df9e84; }
#coin_preview { position: absolute; left: 15px; top: 70px; width: 95px; height: 95px; pointer-events: none; }
.registration-notes { position: absolute; left: 125px; top: 45px; transform-origin: left top; overflow: hidden auto; }
.registered-count { position: absolute; left: 15px; top: 200px; width: 95px; height: 45px; color: #d7b864; }
.registered-count .native-text { margin-bottom: 7px; }
.registration-action { position: absolute; left: 15px; right: 15px; top: 266px; height: 24px; padding: 2px; }
.exchange-notes { position: absolute; left: 15px; top: 40px; transform-origin: left top; overflow: hidden auto; }
.exchange-actions { position: absolute; left: 15px; right: 15px; top: 158px; }
.exchange-actions button { display: block; width: 100%; height: 35px; margin-bottom: 6px; padding: 4px; }
#item_grid { position: absolute; left: 15px; top: 38px; width: 160px; height: 80px; pointer-events: none; }
.reward-grid { position: absolute; left: 15px; top: 38px; width: 160px; height: 80px; pointer-events: none; }
.reward-grid .grid-row { display: flex; width: 160px; height: 20px; }
.reward-grid .cell { width: 20px; height: 20px; box-sizing: border-box; flex: 0 0 20px; background-color: #18211a; border: 1px #484b39; }
.lucky-notes { position: absolute; left: 15px; top: 129px; transform-origin: left top; overflow: hidden auto; }
.lucky-actions { position: absolute; left: 15px; right: 15px; bottom: 14px; height: 24px; display: flex; gap: 6px; }
.lucky-actions button { flex: 1 1 0; height: 24px; padding: 2px; }

.lucky-item-counter.compact-scale #title { height: 40px; overflow: visible; }
.lucky-item-counter.compact-scale #item_grid, .lucky-item-counter.compact-scale .reward-grid { top: 55px; }
.lucky-item-counter.compact-scale .lucky-notes { top: 145px; }

#panel.lucky-item-counter { pointer-events: none; }
.lucky-notes { pointer-events: auto; }

#item_grid_counts { position: absolute; left: 15px; top: 38px; width: 160px; height: 80px; }
.lucky-item-counter #title .native-text { width: calc(160px * var(--root-scale)); }
.lucky-notes { width: calc(160px * var(--root-scale)); height: calc(203px * var(--root-scale)); }
.lucky-actions .native-text { width: calc(70px * var(--root-scale)); }

.lucky-item-counter { --readable-text-px: max(14px, calc(var(--text-px) * 1px)); }
.lucky-item-counter.compact-scale { --readable-text-px: max(11px, calc(var(--text-px) * 1px)); }
.lucky-item-counter .native-text, .lucky-item-counter .lucky-notes { font-size: var(--readable-text-px); }
.lucky-item-counter.compact-scale #item_grid_counts { top: 55px; }

.lucky-item-counter.compact-scale .native-text, .lucky-item-counter.compact-scale .lucky-notes { font-size: max(11px, calc(var(--text-px) * 1px)); }
