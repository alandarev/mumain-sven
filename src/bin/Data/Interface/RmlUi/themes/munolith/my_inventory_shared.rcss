@spritesheet satchel-top { src: "../../../newui_item_back04.tga"; sat-top-left: 0px 0px 48px 42px; sat-top-mid: 64px 0px 62px 42px; sat-top-right: 130px 0px 60px 42px; }
@spritesheet satchel-bottom { src: "../../../newui_item_back03.tga"; sat-bottom-left: 0px 0px 36px 45px; sat-bottom-mid: 64px 0px 62px 45px; sat-bottom-right: 154px 0px 36px 45px; }
@spritesheet satchel-left { src: "../../../newui_item_back02-L.tga"; sat-side-left: 0px 0px 12px 320px; }
@spritesheet satchel-right { src: "../../../newui_item_back02-R.tga"; sat-side-right: 9px 0px 12px 320px; }
@spritesheet satchel-stone { src: "../../../newui_msgbox_back.jpg"; sat-stone: 0px 0px 190px 429px; }
div { display: block; }
body { margin: 0; width: 100%; height: 100%; font-family: "DejaVu Sans"; color: #d5ccb7; font-effect: outline(1px #07090b), shadow(1px 1px #000000); pointer-events: none; }
#panel, #bg_root { position: absolute; width: 190px; height: 240px; transform-origin: left top; }
.stone { position: absolute; left: 5px; right: 5px; top: 7px; bottom: 7px; decorator: image(sat-stone); }
.shade { position: absolute; left: 5px; right: 5px; top: 7px; bottom: 7px; background-color: #080d0ce8; }
.trim { position: absolute; pointer-events: none; }
.top-left { top: 0; left: 0; width: 31px; height: 27px; decorator: image(sat-top-left); }
.top-mid { top: 0; left: 31px; right: 39px; height: 27px; decorator: image(sat-top-mid); }
.top-right { top: 0; right: 0; width: 39px; height: 27px; decorator: image(sat-top-right); }
.side-left { left: 0; top: 26px; bottom: 23px; width: 7px; decorator: image(sat-side-left); }
.side-right { right: 0; top: 26px; bottom: 23px; width: 7px; decorator: image(sat-side-right); }
.bottom-left { left: 0; bottom: 0; width: 23px; height: 28px; decorator: image(sat-bottom-left); }
.bottom-mid { left: 23px; right: 23px; bottom: 0; height: 28px; decorator: image(sat-bottom-mid); }
.bottom-right { right: 0; bottom: 0; width: 23px; height: 28px; decorator: image(sat-bottom-right); }

#panel.expanded-one, #bg_root.expanded-one { height: 320px; }
#panel.expanded-two, #bg_root.expanded-two { height: 400px; }
