<rml>
<!-- bound-geometry: the monsters' gauge is a length from m_fMonsterGauge, stacked in pieces as monsters get through; the Ice Walker's and each party member's marker is their own position along the path (59 + 167 * position) -->

<head>
	<title>Doppelganger frame (CDoppelGangerFrame)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="doppelganger_frame.rcss"/>
</head>
<body data-model="doppelganger_frame">
	<div class="screen">
		<div id="panel">
			<div id="back"></div>
<span class="event-name counter-scaled hud-width-211" data-style-font-size="(passed_line.text_px < 11 ? 11 : passed_line.text_px) + 'px'">Doppelganger</span>
			<!-- The three lines, each placed and coloured by the theme; the monsters-passed line
			     says how many got through. -->
			<span class="frame-text counter-scaled hud-width-211" id="dg_passed" data-class-passed-one="passed_state == 'one'"
			      data-class-passed-several="passed_state == 'several'"
			      data-style-font-size="(passed_line.text_px < 11 ? 11 : passed_line.text_px) + 'px'"
			     >{{passed_line.text}}</span>
			<span class="frame-text counter-scaled hud-width-105" id="dg_time_label" data-style-font-size="(time_label.text_px < 11 ? 11 : time_label.text_px) + 'px'"

			     >{{time_label.text}}</span>
			<span class="frame-text big counter-scaled hud-width-114" id="dg_time" data-style-font-size="(time_line.text_px < 18 ? 18 : time_line.text_px) + 'px'"

			     >{{time_line.text}}</span>
			<img class="bar" data-for="b : bars" data-attr-src="b.src" data-attr-rect="b.rect"
			     data-style-left="b.left + 'px'" data-style-width="b.width + 'px'"/>
			<img id="icewalker" src="../../../Double_Micon01.tga" data-if="ice_walker_visible"
			     data-style-left="ice_walker_left + 'px'"/>
			<div class="marker" data-for="m : markers" data-class-hero="m.hero" data-style-left="m.left + 'px'"></div>
		</div>
	</div>
</body>
</rml>
