#panel { width: 240px; height: 400px; }
#skill_library { position: absolute; left: 15px; top: 43px; width: 210px; height: 338px; overflow: hidden auto; }
.library-skill { display: block; position: relative; height: 38px; margin-bottom: 4px; background-color: #111c15; border: 1px #546047; cursor: pointer; }
.library-skill:hover { background-color: #343122; border-color: #ac9359; }
.library-icon { position: absolute; left: 8px; top: 5px; width: 20px; height: 28px; pointer-events: none; }
.library-name { display: block; position: absolute; left: 40px; top: 11px; color: #c8ceba; white-space: normal; pointer-events: none; }
.library-empty { position: absolute; left: 10px; top: 20px; color: #a8b69e; }

#title { width: calc(240px * var(--root-scale)); }
.library-name { width: calc(151px * var(--root-scale)); }
