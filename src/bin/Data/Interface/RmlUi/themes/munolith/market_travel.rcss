#panel { width: 440px; height: 400px; pointer-events: auto; }
#title { left: 15px; right: 15px; top: 8px; height: 24px; overflow: visible; }
.market-notes { position: absolute; left: 15px; top: 45px; transform-origin: left top; overflow: hidden auto; pointer-events: auto; }
.travel-line { display: block; white-space: normal; color: #c6cbb4; line-height: 1.4em; margin-bottom: 8px; }
#warp { position: absolute; left: 15px; top: 308px; width: 410px; height: 44px; padding: 2px; }
#warp.locked { background-color: #172018; border-color: #384436; color: #82917e; pointer-events: none; }
#warp .native-text, .desk-close .native-text { text-align: center; }
.desk-close { bottom: 10px; height: 36px; }
.desk-close .native-text { line-height: 1.0em; }
