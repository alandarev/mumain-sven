body {
    width: 100%;
    height: 100%;
    margin: 0;
    pointer-events: none;
}
#transition-shade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #07100bb8;
    pointer-events: none;
}
#loading-card {
    position: absolute;
    left: 50%;
    bottom: 12vh;
    transform: translateX(-50%);
    width: 520px;
    max-width: 82vw;
    padding: 22px 26px;
    font-family: "DejaVu Sans";
    box-sizing: border-box;
    background-color: #0c1a12;
    border: 1px #807449;
    pointer-events: none;
}
.loading-kicker { font-size: 12px; color: #a59b74; letter-spacing: 2px; }
.loading-title { margin-top: 8px; font-size: 24px; color: #e6d19a; font-weight: bold; }
.loading-note { margin-top: 8px; font-size: 14px; color: #b6bca8; }
.gauge-fill, .waiting-rail {
    display: block;
    position: relative;
    margin-top: 22px;
    width: 100%;
    height: 6px;
    background-color: #263126;
    border: 1px #514c32;
    pointer-events: none;
}
.gauge-fill fill { background-color: #bfa561; }
.waiting-rail { height: 2px; border-width: 0; background-color: #807449; }
@media (max-width: 900px) {
    #loading-card { bottom: 10vh; padding: 18px 22px; }
    .loading-title { font-size: 22px; }
}

.loading-kicker, .loading-title, .loading-note { display: block; }
#loading-wallpaper { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.loading-tile { position: absolute; }
.loading-top-left { left: 0; top: 0; width: 50%; height: 85.3333%; }
.loading-top-right { left: 50%; top: 0; width: 50%; height: 85.3333%; }
.loading-bottom-left { left: 0; top: 85.3333%; width: 50%; height: 14.6667%; }
.loading-bottom-right { left: 50%; top: 85.3333%; width: 50%; height: 14.6667%; }
