<rml>
<head>
	<title>Workspace</title>
	<link type="text/rcss" href="workspace.rcss"/>
</head>
<body>
	<!-- Where windows and HUD parts go. Each .slot names its window or HUD part in data-window; an
	     open slot is shown (class "open") and its component is placed on it. A theme arranges
	     regions and slots in its workspace.rcss, or forks this file to move slots between regions.

	     The shell: #workspace_shell is a flex column of header, middle and footer; the middle row
	     holds the left side, #safe_area (the content area) and the right side. A shell region's
	     data-participation is reserve (it takes the space, so the content area avoids it) or
	     overlay (placed over the content area, taking no space). A hidden component's slot
	     collapses. A dock region the theme caps (max-height) below its data-ref-height draws its
	     windows smaller, so they fit the content area. The main HUD (main_hud) is one unit: its parts are laid out inside it by
	     main_frame.rcss.

	     Set by the game: each slot's size (its component's own size), and a region's height from
	     data-ref-height, given in its windows' units. A region's data-scale picks the scale its
	     components are drawn at: dock (default), panel or hud. data-closes lists the windows that
	     close when a slot's window opens, because the theme gives them no room beside it. Open
	     slots in a data-covers-world region narrow the world area HUD widgets centre in.
	     A data-group region links its slots: dragging any data-drag-handle moves them together,
	     and data-position-key saves the group's anchor. A window that moves itself (the friend list) only asks its slot where
	     it first opens; the player's moves win after that. -->
	<div id="workspace_shell">
		<div id="shell_header" class="region shell-region" data-scale="hud" data-participation="reserve">
			<div class="slot" data-window="mu_helper_bar"></div>
			<div class="slot" data-window="top_bar"></div>
		</div>
		<div id="shell_middle">
			<div id="shell_left" class="region shell-region" data-scale="hud" data-participation="reserve"></div>
			<div id="safe_area">
<div class="temple-result-host"><div class="region temple-result-stage" data-scale="window" data-ref-width="560" data-ref-height="480"><div class="slot" data-window="cursed_temple_result"></div></div></div>
    <div class="region diagnostics-stack" data-scale="hud" data-participation="overlay">
        <div class="slot" data-window="system_log"></div>
        <div class="slot" data-window="diagnostics"></div>
    </div>

                <div class="master-host"><div class="region master-stage" data-scale="window" data-ref-width="640" data-ref-height="330">
                    <div class="slot" data-window="master_level"></div>
                </div></div>
                <div class="region window-group" data-group="items" data-anchor="inventory" data-position-key="group.items" data-covers-world>
<div class="slot" data-window="pet" data-scale="window" data-drag-handle="#title" data-closes="inventory my_quest party guild_info command command_list gold_bowman gold_bowman_lena gens_ranking mu_helper mu_helper_detail mu_helper_skill_list"></div>
                    <div class="slot" data-window="character" data-scale="window" data-drag-handle="#title" data-closes="party guild_info command command_list gold_bowman gold_bowman_lena gens_ranking mu_helper mu_helper_detail mu_helper_skill_list"></div>
                    <div class="slot" data-window="storage" data-drag-handle="#title"></div>
                    <div class="slot" data-window="npc_shop" data-drag-handle="#title"></div>
                    <div class="slot" data-window="mix" data-drag-handle="#title"></div>
                    <div class="slot" data-window="trade" data-drag-handle="#title"></div>
                    <div class="slot" data-window="my_shop" data-drag-handle="#title"></div>
                    <div class="slot" data-window="purchase_shop" data-drag-handle="#title"></div>
                    <div class="slot" data-window="lucky_coin_registration" data-drag-handle="#title"></div>
                    <div class="slot" data-window="lucky_coin_exchange" data-drag-handle="#title"></div>
                    <div class="slot" data-window="lucky_item" data-drag-handle="#title"></div>
                    <div class="slot" data-window="inventory_extension" data-drag-handle="#title" data-closes="storage_extension my_quest"></div>
                    <div class="slot" data-window="inventory" data-drag-handle="#title" data-closes="party guild_info command command_list gold_bowman gold_bowman_lena gens_ranking mu_helper mu_helper_detail mu_helper_skill_list my_quest"></div>
                </div>
                <div class="region window-group" data-group="events" data-anchor="blood_castle_entry" data-position-key="group.events" data-covers-world><div class="slot" data-window="blood_castle_entry" data-drag-handle="#title"></div><div class="slot" data-window="devil_square_entry" data-drag-handle="#title"></div><div class="slot" data-window="doppelganger_entry" data-drag-handle="#title"></div><div class="slot" data-window="empire_guardian_entry" data-drag-handle="#title"></div><div class="slot" data-window="cursed_temple_entry" data-drag-handle="#title"></div><div class="slot" data-window="kanturu_entry" data-drag-handle="#title"></div></div>
                <div class="region window-group" data-group="social" data-anchor="guild_info" data-position-key="group.social" data-covers-world>
                    <div class="slot" data-window="party" data-scale="window" data-drag-handle="#title"></div>
                    <div class="slot" data-window="guild_info" data-scale="window" data-drag-handle="#title"></div>
                    <div class="slot" data-window="guild_make" data-scale="window" data-drag-handle="#title"></div>
                </div>
                <div class="region window-group" data-group="helper" data-anchor="mu_helper" data-position-key="group.helper" data-covers-world>
                    <div class="slot" data-window="mu_helper_skill_list" data-scale="window" data-drag-handle="#title"></div>
                    <div class="slot" data-window="mu_helper_detail" data-scale="window" data-drag-handle="#title"></div>
                    <div class="slot" data-window="mu_helper" data-scale="window" data-drag-handle="#title"></div>
                </div>
				<div class="region window-group" data-group="command" data-anchor="command" data-position-key="group.command" data-covers-world><div class="slot" data-window="command" data-drag-handle="#title"></div></div><div class="region window-group" data-group="gens_ranking" data-anchor="gens_ranking" data-position-key="group.gens_ranking" data-covers-world><div class="slot" data-window="gens_ranking" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="command-editor" data-anchor="command_list" data-position-key="group.command-editor" data-covers-world><div class="slot" data-window="command_list" data-scale="window" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="castle-desk" data-anchor="castle" data-position-key="group.castle-desk" data-covers-world><div class="slot" data-window="castle" data-scale="window" data-drag-handle="#title"></div></div><div class="region window-group" data-group="guard-desk" data-anchor="guard" data-position-key="group.guard-desk" data-covers-world><div class="slot" data-window="guard" data-scale="window" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="gatekeeper-desk" data-anchor="gatekeeper" data-position-key="group.gatekeeper-desk" data-covers-world><div class="slot" data-window="gatekeeper" data-scale="window" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="gate_switch-desk" data-anchor="gate_switch" data-position-key="group.gate_switch-desk" data-covers-world><div class="slot" data-window="gate_switch" data-scale="window" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="catapult-desk" data-anchor="catapult" data-position-key="group.catapult-desk" data-covers-world><div class="slot" data-window="catapult" data-scale="window" data-drag-handle="#title"></div></div>
<div class="region window-group" data-group="arena-desk" data-anchor="duel_watch" data-position-key="group.arena-desk" data-covers-world><div class="slot" data-window="duel_watch" data-scale="window" data-drag-handle="#title"></div></div>
<!-- Fills from the right edge in document order. -->
				<div class="region dock-right" data-ref-height="432" data-covers-world>



					<div class="slot" data-window="gold_bowman"></div>
					<div class="slot" data-window="gold_bowman_lena"></div>
					<div class="slot" data-window="npc_dialogue" data-scale="window"></div>
					<div class="slot" data-window="quest_progress" data-scale="window"></div>
					<div class="slot" data-window="npc_quest"></div>






					<div class="slot" data-window="united_marketplace"></div>
					<div class="slot" data-window="my_quest" data-scale="window" data-closes="party guild_info command command_list gold_bowman gold_bowman_lena gens_ranking mu_helper mu_helper_detail mu_helper_skill_list inventory pet"></div>
					<div class="slot" data-window="quest_progress_etc" data-scale="window" data-closes="inventory my_quest"></div>
				</div>
				<!-- Fills from the left edge. Not data-covers-world: the original centred nothing around
				     the warp list. -->
				<div class="region dock-left" data-ref-height="432">
					<div class="slot" data-window="move_map"></div>
				</div>
				<!-- The chat: the log stands on the input box, which stands on the content area's
				     bottom edge. Windows draw over it; it takes no room from them. -->
				<div class="region chat-stack" data-scale="hud">
					<div class="slot" data-window="chat_log"></div>
					<div class="slot" data-window="chat_input"></div>
				</div>
				<!-- The event HUDs (timers, scores), at their places in the original's 640x480 frame. -->
				<div class="region event-hud" data-scale="hud">
					<div class="slot" data-window="blood_castle_time"></div>
					<div class="slot" data-window="chaos_castle_time"></div>
					<div class="slot" data-window="battle_soccer"></div>
					<div class="slot" data-window="duel"></div>
					<div class="slot" data-window="kanturu_info"></div>
					<div class="slot" data-window="empire_guardian_timer"></div>
					<div class="slot" data-window="doppelganger_frame"></div>

				</div>
<div class="region viewer-anchor" data-scale="hud"><div class="slot" data-window="duel_watch_users"></div></div>
				<!-- Where the friend list first opens: the corner above the HUD. -->
				<div class="region free-bottom-right">
					<div class="slot" data-window="friends"></div>
				</div>
			</div>
			<div id="shell_right" class="region shell-region" data-scale="hud" data-participation="reserve"></div>
		</div>
		<div id="shell_footer" class="region shell-region" data-scale="hud" data-participation="reserve">
			<div class="slot" data-window="main_hud"></div>
		</div>
	</div>
	<!-- The original's centred NPC panels, on the 640x480 stage it centred them on (outside the
	     safe area: it centred them on the whole screen). -->
	<div class="region panel-stage" data-scale="panel">
	</div>
</body>
</rml>
