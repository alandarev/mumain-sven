@spritesheet menu-stone { src: "../../../newui_msgbox_back.jpg"; menu-stone: 0px 0px 190px 429px; }
body { margin: 0; width: 100%; height: 100%; font-family: "DejaVu Sans"; color: #ddd0ae; font-effect: outline(1px #000000), shadow(1px 1px #000000); pointer-events: none; }
div { display: block; }
#panel { position: absolute; right: 1em; top: 3.5em; width: 12em; padding: .6em; decorator: image(menu-stone); border: 1px #8b8060; background-color: #08120fe8; pointer-events: auto; }
.title { text-align: center; color: #e7c568; padding-bottom: .4em; border-bottom: 1px #49493b; }
.rows { display: flex; flex-direction: column; padding-top: .3em; }
button { display: block; text-align: left; padding: .5em; color: #ddd0ae; background-color: #0b151ce0; border: 1px transparent; pointer-events: auto; cursor: pointer; }
button:hover { border-color: #c2a568; background-color: #283036; color: #fff1c8; }
