<rml>
<head>
	<title>Generic Menu Dialog</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="../legacy/window_shell.rcss"/>
	<link type="text/rcss" href="../legacy/generic_menu_dialog.rcss"/>
	<link type="text/rcss" href="crafting_menu.rcss"/>
	<link type="text/template" href="../legacy/window_shell.rml"/>
</head>
<!-- Sibling primitive to generic_confirm_dialog.rml -- see GenericMenuDialog.h's own class
     comment for why this is a separate primitive (arbitrary N-button list vs two fixed named
     buttons) and why it's a single document, unlike generic_confirm_dialog's fg/bg split (no
     item3D here, so no compositing-order problem to solve).

     This is legacy's own markup in practice -- modern has its own complete fork
     (themes/modern/generic_menu_dialog.rml). Keep ids/data-model/event names in sync,
     GenericMenuDialog.cpp binds both by name.

     Frame/border/header chrome now lives entirely in window_shell.rml (see its own comment) --
     this document supplies only its own content, spliced into that template's #content slot. -->
<body template="window_shell" data-model="generic_menu_dialog" data-class-system-menu="is_system_menu" data-class-crafting-menu="is_crafting_menu"
      data-class-highlight-title="highlight_title" data-style---canvas-top="canvas_top + 'dp'"
      data-class-native-frame="kind != ''" data-attr-data-kind="kind"

     >

	<!-- Inline styles bound below always carry a value ('auto', '0dp', '1.2' -- RmlUi's default
	     line-height, it has no 'normal' keyword -- when unused): an
	     empty inline value does not clear the one a previous menu set on the same element. -->
	<!-- The menu's own lines. With a described native layout (GenericMenuConfig::nativeFrame) they
	     sit where the native box's RenderTexts() drew them: native_text_top is the first line's text
	     top, so the block starts half a line gap above it (glyphs are centred in their line box).
	     Such a centred line (and a recipe line above its button) is one line in the native box's
	     text box, shrunk to it when wider (.native-fit, RmlNativeTextFit.h). -->
	<div data-if="!is_crafting_menu" class="gmd-lines"




	    >
		<div class="gmd-line" data-for="line : lines" data-class-bold="line.bold"
		     data-style-color="line.color == '' ? '#ffffff' : line.color"><span
		     data-class-native-fit="kind == 'npc-menu' || kind == 'trainer-recover' || kind == 'elpis' || kind == 'reset-points' || kind == 'delgardo'">{{line.text}}</span></div>
	</div>
	<div data-if="!is_crafting_menu" class="gmd-divider"
	    ></div>
	<!-- No explicit column count -- .gmd-button-row's own flex-wrap lets the button count/width
	     and the row's available space determine layout, same technique the numeric-keypad grid in
	     generic_confirm_dialog.rcss already proves. Every native consumer's own fixed 128dp button
	     width only ever fits one per row here, so this naturally reproduces their single-column
	     stack with no config knob needed. -->
	<div data-if="!is_crafting_menu" class="gmd-button-row">
		<!-- it_index (RmlUi's own data-for loop variable) passed straight into the click handler
		     -- proven pattern, see char_make.rml's job-select buttons for the original precedent.
		     gmd-button-cell wraps each button together with its own optional description lines
		     (button.lines, a nested data-for -- RmlUi re-parses each outer iteration's own inner
		     RML, so the inner loop and the outer button/it_index aliases both resolve normally) so
		     text that describes one specific button (e.g. CChaosMixMenuMsgBox's per-recipe blurb)
		     renders directly above that button instead of bunched into the shared summary above. -->
		<div class="gmd-button-cell" data-for="button : buttons" data-class-compact="button.compact" data-class-has-lines="button.has_lines" data-class-cols-2="button.cols2"
		     data-class-lines-below="button.lines_below" data-attr-data-button-index="it_index"

		    >
			<!-- native_top is from the panel's top edge; an untitled menu's content box starts 20dp
			     lower (generic_menu_dialog.rcss). With native-placed lines (MenuButton::nativeLinesTop)
			     the cell starts at the first line's box, lines one native_line_advance apart, the
			     button native_button_gap below. -->
			<div class="gmd-line" data-for="line : button.lines" data-class-bold="line.bold"
			     data-style-color="line.color == '' ? '#ffffff' : line.color"
			    ><span
			     data-class-native-fit="kind != ''">{{line.text}}</span></div>
			<div class="btn gmd-btn" data-class-compact="button.compact" data-class-cols-2="button.cols2" data-class-disabled="!button.enabled"
			     data-class-narrow="button.narrow"

			     data-event-click="gmd_button_click(it_index)">
				<!-- Label text lives in its own element rather than raw text directly in
				     .gmd-btn -- see generic_menu_dialog.rcss's own .gmd-btn.cols-2 comment
				     for why (a decorator change, not a markup requirement of its own). -->
				<div class="gmd-btn-label">{{button.label}}</div>
				<span class="gmd-tooltip" data-class-hidden="!button.has_tooltip">{{button.tooltip}}</span>
			</div>
		</div>
	</div>
    <div class="crafting-content" data-if="is_crafting_menu">
        <div class="craft-stone"></div><div class="craft-shade"></div>
        <div class="craft-trim craft-top-left"></div><div class="craft-trim craft-top-mid"></div><div class="craft-trim craft-top-right"></div>
        <div class="craft-trim craft-side-left"></div><div class="craft-trim craft-side-right"></div>
        <div class="craft-trim craft-bottom-left"></div><div class="craft-trim craft-bottom-mid"></div><div class="craft-trim craft-bottom-right"></div>
        <div class="crafting-title">{{title}}</div>
        <button class="crafting-corner-close" data-event-click="gmd_cancel">×</button>
        <div class="crafting-methods scroll-pane">
            <div class="crafting-summary"><div class="crafting-description" data-for="line : lines" data-class-bold="line.bold" data-style-color="line.color == '' ? '#a9a48e' : line.color">{{line.text}}</div></div>
            <div class="crafting-choice" data-for="button : buttons">
                <div class="crafting-description" data-for="line : button.lines">{{line.text}}</div>
                <button class="crafting-method" data-class-compact="button.compact" data-attrif-disabled="!button.enabled" data-event-click="gmd_button_click(it_index)">{{button.label}}</button>
            </div>
        </div>
    </div>
</body>
</rml>
