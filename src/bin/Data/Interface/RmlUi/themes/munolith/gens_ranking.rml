<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Munolith desk</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="gens_marks.rcss"/><link type="text/rcss" href="list_desk_common.rcss"/></head><body><div id="panel" class="gens-desk" data-model="gens_ranking"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-220 counter-scaled scaled-reference" data-style-font-size="(title.text_px < 11 ? 11 : title.text_px) + 'px'">{{title.text}}</span></div><button class="corner-close" data-event-click="gens_ranking_exit">×</button><div id="mark" data-if="mark_sprite != ''" data-attr-class="mark_sprite"/><div class="gens-summary"><div class="summary-label"><span class="native-text scaled-width-140 counter-scaled scaled-reference" data-style-font-size="(gens_label.text_px < 11 ? 11 : gens_label.text_px) + 'px'">{{gens_label.text}}</span></div><div><span class="native-text scaled-width-140 counter-scaled scaled-reference" data-style-font-size="(gens_name.text_px < 11 ? 11 : gens_name.text_px) + 'px'">{{gens_name.text}}</span></div><div class="summary-label"><span class="native-text scaled-width-140 counter-scaled scaled-reference" data-style-font-size="(level_label.text_px < 11 ? 11 : level_label.text_px) + 'px'">{{level_label.text}}</span></div><div><span class="native-text scaled-width-140 counter-scaled scaled-reference" data-style-font-size="(title_name.text_px < 11 ? 11 : title_name.text_px) + 'px'">{{title_name.text}}</span></div></div><div class="gens-values scaled-width-220 counter-scaled scaled-reference" data-style-font-size="(title.text_px < 11 ? 11 : title.text_px) + 'px'"><div class="value-card"><div class="summary-label">{{rank_label.text}}</div><div>{{rank_value.text}}</div></div><div class="value-card"><div class="summary-label">{{contrib_label.text}}</div><div>{{contrib_value.text}}</div></div></div><div class="notes-heading"><span class="native-text scaled-width-220 counter-scaled scaled-reference" data-style-font-size="(desc_label.text_px < 11 ? 11 : desc_label.text_px) + 'px'">{{desc_label.text}}</span></div><div class="gens-notes scroll-pane scaled-width-220 scaled-height-100 counter-scaled scaled-reference" data-style-font-size="(title.text_px < 11 ? 11 : title.text_px) + 'px'"><div class="promotion" data-for="l : promo_lines">{{l.text}}</div><div class="reward" data-for="l : desc_lines">{{l.text}}</div></div><button id="btn_exit" class="desk-close" data-event-click="gens_ranking_exit"><span class="native-text scaled-width-220 counter-scaled scaled-reference" data-style-font-size="(title.text_px < 11 ? 11 : title.text_px) + 'px'">{{exit_tooltip}}</span></button></div></body></rml>
