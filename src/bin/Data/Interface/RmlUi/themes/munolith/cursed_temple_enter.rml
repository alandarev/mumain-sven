<rml><head><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Event entry</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="event_desk_common.rcss"/></head><body data-model="cursed_temple_enter"><div id="panel" class="temple-desk" data-compact-scale="1.2"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-191 counter-scaled scaled-reference" data-style-font-size="((text_px < 11 ? 11 : text_px) * 1.1) + 'px'">Illusion Temple</span></div><button class="corner-close" data-event-click="temple_close">×</button><div class="temple-question"><span class="native-text scaled-width-200 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{title}}</span></div><div class="temple-current" data-if="eligible"><span class="native-text scaled-width-200 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{temple_line.text}}</span></div><div class="temple-bands scroll-pane" data-if="eligible"><div class="temple-band" data-for="b : bands" data-class-hero="b.hero"><span class="native-text scaled-width-190 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{b.text}}</span></div></div><div class="temple-members" data-if="eligible"><span class="native-text scaled-width-200 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{members_line.text}}</span></div><div class="temple-notice" data-if="!eligible"><span class="native-text scaled-width-200 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{notice.text}}</span></div><div class="actions"><button id="btn_close" data-event-click="temple_close"><span class="native-text scaled-width-96 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{close_text}}</span></button><button id="btn_enter" data-class-locked="!eligible" data-attrif-disabled="!eligible" data-event-click="temple_enter"><span class="native-text scaled-width-96 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{enter_text}}</span></button></div></div></body></rml>
