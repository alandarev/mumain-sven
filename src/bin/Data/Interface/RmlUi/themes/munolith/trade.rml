<rml>
<head><link type="text/rcss" href="../legacy/item_grid.rcss"/><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="native_items.rcss"/><title>Trade</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="trade.rcss"/></head>
<body data-model="trade"><div id="panel"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div>
<div id="title"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{title}}</span></div>
<button id="btn_corner_close" data-event-click="trade_exit_click">×</button>
<div id="your_guild_name" data-if="your_guild_visible"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{your_guild_name}}</span></div>
<div id="your_id_text"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{your_id_text}}</span></div>
<div id="your_level_text"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{your_level_text}}</span></div>
<div id="partner_grid" class="native-anchor themed-grid item-grid"><div class="item-grid-cells"><div data-for="c : partner_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div>
<div id="partner_ready_overlay" class="ready-overlay partner" data-if="your_confirm_checked"/>
<div id="your_gold_bg" class="zen-strip partner" data-class-ready="your_confirm_checked"><span class="zen-label">Zen</span><div class="zen-value"><span id="your_gold_text" class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{your_gold_text}}</span></div></div>
<div id="divider"/>
<div id="my_id_text"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{my_id_text}}</span></div>
<div id="item_grid" class="native-anchor themed-grid item-grid"><div class="item-grid-cells"><div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div></div><img id="item_view" class="item-view"/><div id="item_grid_counts" class="item-grid-counts"><div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div><div id="partner_grid_counts" class="item-grid-counts"><div class="item-count" data-for="c : partner_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div>
<div id="my_ready_overlay" class="ready-overlay local" data-if="my_confirm_checked"/>
<button id="my_gold_bg" class="zen-strip local" data-class-ready="my_confirm_checked" data-event-click="trade_zen_click"><span class="zen-label">Zen</span><div class="zen-value"><span id="my_gold_text" class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{my_gold_text}}</span></div></button>
<div class="trade-actions"><button id="btn_exit" data-event-click="trade_exit_click"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">Cancel</span></button><button id="my_confirm" data-class-ready="my_confirm_checked" data-class-waiting="my_confirm_waiting" data-event-click="trade_my_confirm_click"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'"><span data-if="my_confirm_waiting">Wait</span><span data-if="!my_confirm_waiting &amp;&amp; my_confirm_checked">Unready</span><span data-if="!my_confirm_waiting &amp;&amp; !my_confirm_checked">Ready</span></span></button></div>
<div class="native-text item-warning-badge counter-scaled" data-for="w : item_warning_badges" data-style---warning-x="w.x" data-style---warning-y="w.y" data-style---warning-width="w.width" data-style-font-size="text_px + 'px'">{{item_warning_text}}</div>
</div></body></rml>
