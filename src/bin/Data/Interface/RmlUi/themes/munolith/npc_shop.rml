<rml><head><link type="text/rcss" href="../legacy/item_grid.rcss"/><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="native_items.rcss"/><title>Merchant Counter</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="npc_shop.rcss"/></head>
<body data-model="npc_shop"><div id="panel"><div class="stone"></div><div class="shade"></div><div class="trim top-left"></div><div class="trim top-mid"></div><div class="trim top-right"></div><div class="trim side-left"></div><div class="trim side-right"></div><div class="trim bottom-left"></div><div class="trim bottom-mid"></div><div class="trim bottom-right"></div>
<div id="title"><span class="native-text counter-scaled" data-style-font-size="(text_px * 1.15) + 'px'">{{title}}</span></div>
<button id="counter_close" data-event-click="counter_close">×</button>
<div id="item_grid" class="stock-grid item-grid"><div class="grid-row" data-for="row : rows"><span></span></div><div class="item-grid-cells"><div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop"><div class="item-cell-drop"></div></div></div><div id="item_grid_counts" class="item-grid-counts"><div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''" data-style-font-size="text_px + 'px'">{{c.count}}</span></div></div>
<div id="stock_highlight" data-if="highlight_visible" data-class-pending="buy_pending" data-style---stock-column="highlight_column" data-style---stock-row="highlight_row" data-style---stock-width="highlight_width" data-style---stock-height="highlight_height"/></div>
<img id="item_view" class="item-view"/><div class="readout"><div class="context-name"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{context_name}}</span></div><div class="context-price"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'">{{context_price}}</span></div><div class="context-hint"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">{{context_hint}}</span></div></div>
<div class="services" data-if="repair_visible"><button data-class-active="repair_active" data-event-click="npc_shop_repair_click"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Repair [L]</span></button><button data-event-click="npc_shop_repair_all_click"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Repair all [A]</span></button></div>
<button class="stop-buy" data-if="buy_pending" data-event-click="quantity_cancel"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Stop</span></button>
<div class="quantity-shade" data-if="quantity_open"/>
<div id="quantity_picker" data-if="quantity_open" data-event-keydown="quantity_key"><div class="quantity-title"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'" >{{quantity_name}}</span></div><div class="quantity-label"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Offers</span></div><div class="quantity-controls"><button data-event-click="quantity_less">−</button><input type="text" maxlength="3" data-class-invalid="!quantity_valid" data-value="quantity" data-event-keydown="quantity_key"/><button data-event-click="quantity_more">+</button></div><div class="quantity-total"><span class="native-text counter-scaled" data-style-font-size="text_px + 'px'" >{{quantity_total}}</span></div><div class="quantity-actions"><button data-event-click="quantity_cancel"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Cancel</span></button><button data-attrif-disabled="!quantity_valid" data-event-click="quantity_buy"><span class="native-text counter-scaled" data-style-font-size="(text_px * 0.9) + 'px'">Buy [Enter]</span></button></div></div>
</div></body></rml>
