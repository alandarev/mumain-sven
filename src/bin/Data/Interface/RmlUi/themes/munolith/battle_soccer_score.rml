<rml>
<head>
	<title>Battle Soccer</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="../legacy/battle_soccer_score.rcss"/>
	<link type="text/rcss" href="match_scorecard.rcss"/>
</head>
<body data-model="battle_soccer_score" class="guild-card">
	<!-- The battle-soccer / guild-war scoreboard (CBattleSoccerScore) above the bottom HUD's right
	     end: two lines of score, guild mark and name. A LayoutMode::Hud window, so .screen is the
	     640x480 reference screen stretched W/640 x H/480 like the original and #panel sits at the
	     window's reference position (m_Pos). Text does not stretch: each value takes the native
	     bold text size and cancels the stretch. A guild mark is its 8 x 8 cells, one reference px
	     each (the original's 8 x 8 emblem texture, nearest filtered). Takes no pointer events. -->
	<div class="screen">
		<div id="panel">
			<div id="back"></div>
			<span class="match-caption counter-scaled" data-style-font-size="(bold_text_px &lt; 8 ? 8 : bold_text_px) + 'px'">Guild match</span>
			<!-- Our guild's war or a spectated match: two teams, or none at all. The theme puts
			     each on its own row. -->
			<div class="teams">
				<div class="team" data-for="team : teams" data-class-red="team.red">
					<span class="team-text team-score counter-scaled" data-style-font-size="(bold_text_px &lt; 8 ? 8 : bold_text_px) + 'px'"
					     >{{team.score}}</span>
					<div class="mark" data-if="team.mark.size > 0">
						<div class="mark-cell" data-for="cell : team.mark" data-style-background-color="cell"></div>
					</div>
					<span class="team-text team-name counter-scaled hud-width-106" data-style-font-size="(bold_text_px &lt; 8 ? 8 : bold_text_px) + 'px'"
					     >{{team.name}}</span>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
