<rml>

<head><link type="text/rcss" href="scaled_content.rcss"/>
	<title>NPC Quest</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="my_inventory_shared.rcss"/>
	<link type="text/rcss" href="../legacy/npc_quest.rcss"/>
	<link type="text/rcss" href="npc_quest.rcss"/>
</head>
<!-- Foreground stays transparent over native quest-condition item models. -->
<body>
	<div id="content_root" data-model="npc_quest" data-class-has-conditions="show_conditions"

	     data-style---text-px="text_px"><img id="nq_item" class="nq-item"/>
		<span class="sharp-text counter-scaled scaled-width-190 scaled-reference" id="title"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'">{{npc_name}}</span>
		<div class="sharp-text nq-quest-title counter-scaled scaled-width-190 scaled-reference" data-class-hidden="!show_quest_title"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'">{{quest_title}}</div>

		<div class="nq-divider" data-class-hidden="!show_conditions"></div>
		<!-- id read live by NPCQuest.cpp's RenderItem3D() -- its own resolved position/child-row
		     height replace a hardcoded m_Pos+235/32px-step, so the still-native quest-item icon
		     preview stays aligned with these RmlUi-rendered rows across a theme change. -->
		<div id="conditions_anchor" class="sharp-text nq-conditions counter-scaled scaled-width-132 scaled-reference" data-class-hidden="!show_conditions"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'" data-style-line-height="((text_px &lt; 8 ? 8 : text_px) * 1.3) + 'px'">
			<div class="nq-condition-row" data-for="c : conditions" data-style-color="c.color">{{c.text}}</div>
		</div>
		<div id="btn_complete" class="sharp-text nq-btn-complete counter-scaled scaled-width-128 scaled-height-29 scaled-line-height-29 scaled-reference" data-class-hidden="!show_conditions" data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'"
		     data-class-disabled="!complete_enabled" data-event-click="npcquest_complete">{{complete_label}}</div>

		<div class="nq-cost" data-class-hidden="!show_cost">
			<span class="sharp-text nq-cost-label counter-scaled"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'">{{cost_label}}</span>
			<span class="sharp-text nq-cost-amount gold-amount counter-scaled scaled-width-150 scaled-reference" data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'"
			      data-class-gold-base="cost_tier == 'base'"
			      data-class-gold-hundred-thousand="cost_tier == 'hundred-thousand'"
			      data-class-gold-million="cost_tier == 'million'"
			      data-class-gold-ten-million="cost_tier == 'ten-million'">{{cost_amount}}</span>
		</div>

		<!-- Messages and answers are positioned separately, as native draws them (message_top /
		     answers_top, NPCQuestRmlModel.h). -->
		<div id="dialogue_message" class="sharp-text nq-dialogue scroll-pane nq-message-pane counter-scaled scaled-width-166 scaled-reference"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'" data-style-line-height="((text_px &lt; 8 ? 8 : text_px) * 1.4) + 'px'">
			<span class="nq-message-line" data-for="m : message_lines">{{m.text}}</span>
		</div>
		<div id="dialogue_answers" class="sharp-text nq-dialogue scroll-pane nq-answers-pane counter-scaled scaled-width-166 scaled-reference"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'" data-style-line-height="((text_px &lt; 8 ? 8 : text_px) * 1.4) + 'px'">
			<div class="nq-answer-row" data-for="a : answers"
			     data-event-click="npcquest_select_answer(a.index)">{{a.text}}</div>
		</div>

		<div id="btn_exit" data-event-click="npcquest_click_close">
			<span class="btn-exit-label">×</span>
		</div>
		<span class="sharp-text tooltip tooltip-exit counter-scaled scaled-width-110 scaled-padding-2-4 scaled-reference"
		     data-style-font-size="(text_px &lt; 8 ? 8 : text_px) + 'px'"><span class="tooltip-text scaled-padding-0-3 scaled-reference">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
