<rml><head><link type="text/rcss" href="scaled_content.rcss"/><title>Castle service</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="castle_desks_common.rcss"/><link type="text/rcss" href="siege_service_common.rcss"/></head><body><div id="panel" class="gatekeeper-desk" data-model="gateman" data-compact-scale="0.9" data-style---text-px="text_px"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-370 readable-text counter-scaled scaled-reference">{{title.text}}</span></div><button class="corner-close" data-event-click="gateman_button(4)">×</button><div class="keeper-content scroll-pane scaled-width-370 scaled-height-215 readable-text counter-scaled scaled-reference"><div data-if="page == 1"><div class="service-line">{{restriction.text}}</div><div class="service-line">{{members_line1.text}}</div><div class="service-line">{{members_line2.text}}</div><div class="service-line">{{members_line3.text}}</div><button class="public-setting readable-text" data-event-click="gateman_public_toggle"><span class="check" data-class-on="is_public">✓</span>{{open_to_non_members.text}}</button><div class="service-line">{{entrance_fee.text}}</div><div class="service-line">{{fee_setting_label.text}}</div><div class="fee-draft"><div>{{view_fee.text}}</div><button data-event-click="gateman_button(3)" class="readable-text">−</button><button data-event-click="gateman_button(2)" class="readable-text">+</button></div><div class="service-line">{{fee_range.text}}</div><div class="service-line">{{fee_range_for.text}}</div><div class="service-line">{{fee_increment.text}}</div></div><div data-if="page == 2"><div class="service-line">{{member_question.text}}</div></div><div data-if="page == 3"><div data-if="is_public"><div class="service-line" data-class-unaffordable="!guest_can_afford">{{guest_fee.text}}</div><div class="service-line">{{guest_pay_prompt.text}}</div><div class="service-line">{{guest_question.text}}</div></div><div data-if="!is_public"><div class="service-line">{{denied_line1.text}}</div><div class="service-line">{{denied_line2.text}}</div><div class="service-line">{{denied_line3.text}}</div><div class="service-line">{{denied_line4.text}}</div></div></div></div><div class="service-actions"><button data-if="confirm_button.shown" data-class-locked="confirm_button.locked" data-attrif-disabled="confirm_button.locked" data-event-click="gateman_button(1)"><span class="native-text scaled-width-170 readable-text counter-scaled scaled-reference">{{confirm_button.label}}</span></button><button data-if="enter_button.shown" data-class-locked="enter_button.locked" data-attrif-disabled="enter_button.locked" data-event-click="gateman_button(0)"><span class="native-text scaled-width-170 readable-text counter-scaled scaled-reference">{{enter_button.label}}</span></button></div><button class="desk-close" data-event-click="gateman_button(4)"><span class="native-text scaled-width-370 readable-text counter-scaled scaled-reference">{{exit_tooltip}}</span></button></div></body></rml>
