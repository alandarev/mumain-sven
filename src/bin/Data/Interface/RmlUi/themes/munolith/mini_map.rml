<rml>
<!-- bound-geometry: each .clip is a region of the window the map may paint in, carved around the native bottom HUD's band from the live window size, with .world offsetting its copy of the picture back to window coordinates; a marker's size and turned quad are its own; the location hint is sized to its measured text and placed where the pointer is. The map's own art is turned 45 degrees in physical px (MiniMapLayout.h), which is why this document has no reference-px space for a theme to work in -->

<head>
	<title>Mini Map</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="../legacy/mini_map.rcss"/>
	<link type="text/rcss" href="mini_map.rcss"/>
</head>
<body data-model="mini_map">
	<!-- The full-screen mini map (CMiniMap, Tab or the window menu's Map row). The original drew it
	     in physical pixels: the map texture and its markers turned 45 degrees around the window
	     centre (RenderBitRotate/RenderPointRotate), the frame under the Hud layout's W/640 x H/480
	     stretch. C++ builds every turned quad as a CSS matrix() in physical px (MiniMapLayout.h);
	     .screen carries the stretch for the frame, the hero arrow and the close button.

	     The compact HUD is a foreground RmlUi document: the map paints the whole viewport
	     underneath its transparent gaps. Native HUD themes still reserve their strip, using
	     .clip regions whose .world copies are offset back to window coordinates. -->
	<div class="clip" data-for="clip : clips" data-style-left="clip.left + 'px'" data-style-top="clip.top + 'px'"
	     data-style-width="clip.width + 'px'" data-style-height="clip.height + 'px'">
		<div class="world" data-style-left="clip.world_left + 'px'" data-style-top="clip.world_top + 'px'">
			<div class="screen">
				<div class="dim"></div>
			</div>
			<img class="map" data-attr-src="map_source" data-style-transform="map_transform"/>
			<div class="marker" data-for="marker : markers" data-class-portal="marker.portal"
			     data-style-width="marker.size + 'px'" data-style-height="marker.size + 'px'"
			     data-style-transform="marker.transform"></div>
			<div class="screen">
				<div class="hero"></div>
				<!-- The top and bottom edge tiling: 25 fixed 35-unit tiles each, which the theme
				     lays out. -->
				<div class="edges edges-top"><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div><div class="edge-top"></div></div>
				<div class="edges edges-bottom"><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div><div class="edge-bottom"></div></div>
			</div>
			<!-- Extend the legacy 430-row side tiling to the full 480-row viewport.
			     The complete frame stays behind the foreground compact HUD. -->
			<div class="side-frame"><div class="edge-side" data-for="line : side_lines" data-style-transform="line"></div></div>
			<div class="screen">
				<div class="corner corner-tl"></div>
				<div class="corner corner-tr"></div>
				<div class="corner corner-bl"></div>
				<div class="corner corner-br"></div>
				<div class="hit"></div>
				<div class="close" data-event-click="minimap_close"></div>
			</div>
			<div class="hint" data-if="hint_visible" data-style-left="hint_left + 'px'" data-style-top="hint_top + 'px'"
			     data-style-width="hint_width + 'px'" data-style-height="hint_height + 'px'">
				<span class="hint-text" data-style-font-size="text_px + 'px'" data-style-line-height="hint_height + 'px'">{{hint_text}}</span>
			</div>
		</div>
	</div>
<div id="map_legend"><div class="map-caption">World map</div><div class="legend-row"><span class="legend-icon legend-hero"/><span>You</span><span class="legend-icon legend-npc"/><span>NPC</span><span class="legend-icon legend-portal"/><span>Portal</span></div><div class="legend-help">Tab / Esc to close</div></div>
</body>
</rml>
