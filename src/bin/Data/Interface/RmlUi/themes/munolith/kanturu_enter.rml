<rml><head><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="scaled_content.rcss"/><title>Event entry</title><link type="text/rcss" href="my_inventory_shared.rcss"/><link type="text/rcss" href="event_desk_common.rcss"/></head><body data-model="kanturu_enter"><div id="panel" class="kanturu-desk"><div class="stone"/><div class="shade"/><div class="trim top-left"/><div class="trim top-mid"/><div class="trim top-right"/><div class="trim side-left"/><div class="trim side-right"/><div class="trim bottom-left"/><div class="trim bottom-mid"/><div class="trim bottom-right"/><div id="title"><span class="native-text scaled-width-191 counter-scaled scaled-reference" data-style-font-size="((text_px < 11 ? 11 : text_px) * 1.1) + 'px'">Kanturu</span></div><button class="corner-close" data-event-click="kanturu_close">×</button><div class="kanturu-content scroll-pane scaled-width-200 scaled-height-178 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'"><div class="kanturu-line" data-for="line : lines" data-class-tone-subject="line.kind == 'subject'" data-class-tone-state="line.kind == 'state'" data-class-tone-note="line.kind == 'note'">{{line.text}}</div></div><div class="actions"><button id="btn_refresh" data-class-locked="refresh_locked" data-attrif-disabled="refresh_locked" data-event-click="kanturu_refresh"><span class="native-text scaled-width-59 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{refresh_text}}</span></button><button id="btn_enter" data-class-locked="enter_locked" data-attrif-disabled="enter_locked" data-event-click="kanturu_enter"><span class="native-text scaled-width-59 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{enter_text}}</span></button><button id="btn_close" data-event-click="kanturu_close"><span class="native-text scaled-width-59 counter-scaled scaled-reference" data-style-font-size="(text_px < 11 ? 11 : text_px) + 'px'">{{close_text}}</span></button></div></div></body></rml>
