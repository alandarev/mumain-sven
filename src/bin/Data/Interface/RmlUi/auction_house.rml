<rml>
<head><title>Auction House</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="auction_house.rcss"/></head>
<body class="window-design" data-model="auction_house">
<div id="panel" class="center-both" data-class-working="busy" data-class-reviewing="review || filters_open" data-class-selling="tab == 'sell'" data-class-managing="tab == 'own' || tab == 'collection'" data-class-empty-list="(tab == 'own' || tab == 'collection') &amp;&amp; rows.size == 0" data-class-browsing="tab == 'browse'" data-class-goods="goods &amp;&amp; tab == 'browse'">
  <div class="stone-grid"><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div></div><div class="stone-scrim"></div>
  <div class="panel-inset"></div>
  <div id="titlebar"><div class="brand"><div class="heading">Auction House</div><div class="subtitle">Zyro</div></div><span class="wallet">{{wallet}}</span><button class="close" data-event-click="close" title="Close">×</button></div>
  <div class="tabs">
    <button data-class-active="tab == 'browse'" data-event-click="tab('browse')">Browse</button>
    <button data-class-active="tab == 'sell'" data-event-click="tab('sell')">Sell</button>
    <button data-class-active="tab == 'own'" data-event-click="tab('own')">My auctions</button>
    <button data-class-active="tab == 'collection'" data-event-click="tab('collection')">Collection <span class="badge" data-if="pending > 0">{{pending}}</span></button>
  </div>
  <div class="browse-toolbar" data-if="tab == 'browse'">
    <div class="browse-search"><div class="categories"><button data-class-active="category == '0'" data-event-click="category('0')">Equipment</button><button data-class-active="category == '1'" data-event-click="category('1')">Jewels</button><button data-class-active="category == '2'" data-event-click="category('2')">Materials</button></div><input class="text-field search" type="text" maxlength="64" placeholder="Name or option…" data-value="search" data-event-change="filter"/><button class="btn action" data-event-click="filter">Search</button></div>
    <div class="browse-controls" data-if="!goods"><div class="control equipment-control"><label>Equipment</label><select data-value="equipment" data-event-change="equipment"><option value="0">All equipment</option><option value="1">Weapons</option><option value="2">Armor</option><option value="3">Wings</option><option value="4">Accessories</option></select></div><div class="control" data-if="types.size > 1"><label>Type</label><select data-value="item_type" data-event-change="filter"><option data-for="choice : types" data-attr-value="choice.value">{{choice.label}}</option></select></div><div class="control option-control" data-if="options.size > 1"><label>Option</label><select data-value="option" data-event-change="filter"><option data-for="choice : options" data-attr-value="choice.value">{{choice.label}}</option></select></div><div class="filter-actions"><button class="filter-toggle" data-event-click="usable"><span class="checkbox-box" data-class-checked="usable"></span><span>Can equip</span></button><button class="btn action" data-event-click="open_filters">Filters</button></div></div>
    <div class="filter-chips" data-if="active_filters.size > 0"><button class="chip" data-for="chip : active_filters" data-event-click="clear_filter(chip.value)">{{chip.label}} ×</button></div>
  </div>
  <div class="workspace">
    <div class="main" data-if="tab != 'sell'">
      <div class="list-toolbar"><span data-if="tab != 'collection'">{{count}}</span><div class="sort-control" data-if="tab == 'browse' &amp;&amp; !goods"><span>Sort</span><select data-value="sort" data-event-change="filter"><option value="0">Lowest price</option><option value="1">Highest price</option><option value="2">Ending soon</option><option value="3">Newest</option></select></div><button class="btn action" data-if="tab == 'collection' &amp;&amp; rows.size > 0" data-event-click="claim(-1)" data-class-disabled="busy">Collect all</button></div>
      <div id="results" class="scroll-pane">
        <div class="listing" data-class-selected="row.selected" data-class-changed="row.changed" data-for="row : rows" data-event-click="select(row.index)" data-event-mouseover="hover(row.index)" data-event-mouseout="leave">
          <img class="item-icon" data-if="row.icon != 'zen'" data-attr-id="'row-icon-' + row.index"/><span class="zen-icon" data-if="row.icon == 'zen'">Z</span>
          <div class="listing-copy"><div class="item-name" data-class-excellent="row.tone == 'excellent'" data-class-ancient="row.tone == 'ancient'" data-class-socket="row.tone == 'socket'">{{row.name}}</div><div class="row-preview" data-if="goods &amp;&amp; tab == 'browse'">{{row.price}}</div><div class="row-preview" data-if="tab == 'browse' &amp;&amp; row.summary != ''">{{row.summary}}</div><div class="matched" data-class-highlighted="row.highlighted" data-if="tab == 'browse' &amp;&amp; row.matched != ''">{{row.matched}}</div><div class="muted" data-if="tab == 'own'">{{row.price}} · {{row.meta}}</div><div class="muted" data-if="tab == 'collection'">{{row.meta}}</div><span class="danger" data-if="row.cannot_equip">Cannot Equip</span></div>
          <div class="listing-action" data-if="!goods || tab != 'browse'"><div class="gold" data-if="tab == 'browse'">{{row.price}}</div><div class="muted" data-if="tab == 'browse'">{{row.meta}}</div><span class="muted" data-if="row.own">Yours</span><button class="quiet" data-if="tab == 'own'" data-event-click="cancel_listing(row.index)">Cancel</button><button class="btn action" data-if="tab == 'collection'" data-event-click="claim(row.index)">Collect</button></div>
        </div>
        <div class="empty" data-if="!loading &amp;&amp; rows.size == 0"><span data-if="tab == 'collection'">Nothing to collect</span><span data-if="tab == 'own'">No listings</span><span data-if="tab == 'browse'">No matches</span><button class="quiet" data-if="tab == 'browse'" data-event-click="reset">Reset filters</button></div><div class="loading" data-if="loading">Loading…</div><button class="quiet more" data-if="more &amp;&amp; !loading" data-event-click="more">Load more</button>
      </div>
      <div class="depth scroll-pane" data-if="goods &amp;&amp; selected &amp;&amp; quote_tiers.size > 0"><div class="depth-row muted"><span>Unit price</span><span>Stock</span><span>In your order</span></div><div class="depth-row" data-class-changed="tier.changed" data-for="tier : quote_tiers"><span>{{tier.price}}<span class="tier-note" data-if="tier.note != ''"> {{tier.note}}</span></span><span>{{tier.stock}}</span><span>{{tier.order}}</span></div><div class="depth-footer muted" data-if="quote_beyond != ''">{{quote_beyond}}</div><div class="depth-footer" data-if="quote_order != ''">{{quote_order}}</div></div>
    </div>
    <div class="main inventory-pane" data-if="tab == 'sell'">
      <div class="list-toolbar"><span>Inventory</span><button class="quiet" data-event-click="refresh">Refresh</button></div>
      <div class="inventory scroll-pane"><button class="inventory-item" data-for="row, row_index : inventory" data-event-click="inventory(row.index)" data-event-mouseover="inventory_hover(row_index)" data-event-mouseout="leave"><img class="item-icon" data-attr-id="'inventory-icon-' + row_index"/><span data-class-excellent="row.tone == 'excellent'" data-class-ancient="row.tone == 'ancient'" data-class-socket="row.tone == 'socket'">{{row.name}}</span><span class="units muted" data-if="row.units > 1">×{{row.units}}</span></button></div>
    </div>
    <div class="details scroll-pane" data-if="tab == 'browse' || tab == 'sell'">
      <div data-if="selected">
        <div class="detail-hero"><img id="selected-icon" class="selected-icon"/><div class="item-name" data-class-excellent="selected_tone == 'excellent'" data-class-ancient="selected_tone == 'ancient'" data-class-socket="selected_tone == 'socket'">{{selected_name}}</div></div>
        <div class="item-detail">{{selected_detail}}</div><div class="item-options" data-if="selected_options != ''">{{selected_options}}</div><div class="requirements" data-if="selected_requirements != ''">{{selected_requirements}}</div><span class="danger" data-if="cannot_equip &amp;&amp; tab == 'browse'">Cannot Equip</span>
        <div data-if="tab == 'browse'">
          <div class="selected-price" data-if="!goods"><span>Price</span><span class="gold">{{selected_price}}</span></div>
          <div data-if="goods"><label>Quantity</label><input id="buy-quantity" class="text-field" type="text" maxlength="10" data-value="buy_quantity" data-event-change="quote" data-event-focus="select_content"/><div class="fee-row"><span>Total</span><span class="gold">{{quote_total}}</span></div><div class="field-note danger" data-if="quote_short != ''">{{quote_short}}</div><div class="quote-freshness" data-if="quote_age != ''"><span class="muted">{{quote_age}}</span><button class="quiet refresh-quote" data-event-click="refresh_quote" data-class-disabled="busy">Refresh</button></div></div>
          <button class="btn action primary" data-event-click="buy" data-class-disabled="busy || loading">Buy</button><div class="seller muted" data-if="selected_seller != ''">Seller {{selected_seller}}</div>
        </div>
        <div class="sell-fields" data-if="tab == 'sell'">
          <button class="find-similar" data-if="!sell_goods" data-event-click="similar">Find similar</button>
          <div data-if="sell_goods"><label>Quantity</label><div class="quantity-input"><input id="sell-quantity" class="text-field" type="text" maxlength="10" data-value="quantity" data-event-change="sell_change" data-event-focus="select_content"/><button class="quiet max" data-event-click="max_quantity" data-class-disabled="busy">{{max_quantity}}</button></div></div>
          <div class="price-label"><label data-if="sell_goods">Price per item · Zen</label><label data-if="!sell_goods">Price · Zen</label><span class="price-source" data-if="price_source != ''">{{price_source}}</span><button class="quiet forget" data-if="can_forget" data-event-click="forget_price" data-class-disabled="busy">Forget</button></div>
          <div class="price-input"><button class="quiet step" data-event-click="minus" data-class-disabled="!step_down || busy">−</button><input id="sell-price" class="text-field" type="text" maxlength="24" data-value="price" data-event-change="price_change" data-event-blur="price_commit" data-event-keydown="price_key" data-event-mousescroll="price_wheel" data-event-focus="select_content" placeholder="Enter price"/><button class="quiet step" data-event-click="plus" data-class-disabled="!step_up || busy">+</button></div>
          <div class="price-help muted" data-if="price == ''">590,000 · 590k · 1.5kk · 2.3b</div><div class="price-note" data-if="price_note != ''">{{price_note}}</div>
          <div class="market" data-if="sell_goods"><div class="market-lowest">{{market_lowest}}</div><div class="market-actions"><button class="quiet" data-event-click="match_lowest" data-class-disabled="!can_match || busy">Match lowest</button><button class="quiet" data-event-click="undercut" data-class-disabled="!can_undercut || busy">Undercut</button></div><div class="sell-depth scroll-pane" data-if="sell_tiers.size > 0"><div class="depth-row muted"><span>Unit price</span><span>Stock</span></div><div class="depth-row" data-for="tier : sell_tiers"><span>{{tier.value}}</span><span>{{tier.label}}</span></div></div></div>
          <div class="sale-exact gold" data-if="!sell_goods">{{sale_total}}</div>
          <div class="duration" data-if="duration != ''"><span>Duration</span><span>{{duration}}</span></div><select data-if="duration == ''" data-value="duration_value" data-event-change="sell_change"><option data-for="choice : durations" data-attr-value="choice.value">{{choice.label}}</option></select>
          <div class="fee-row" data-if="sell_goods"><span>Total</span><span>{{sale_total}}</span></div><div class="fee-row"><span>Posting fee</span><span>{{posting_fee}}</span></div><div class="fee-row"><span>Sale fee</span><span>{{sale_fee}}</span></div><div class="fee-row gold"><span>Net proceeds</span><span>{{proceeds}}</span></div>
          <button class="btn action primary" data-event-click="sell" data-class-disabled="!sell_ready || busy">Review listing</button>
        </div>
      </div><div class="empty" data-if="!selected &amp;&amp; tab == 'sell'">Select an item</div>
    </div>
  </div>
  <div class="status" data-class-danger="status_error" data-if="status != ''">{{status}}</div>
  <div class="filter-shade" data-if="filters_open"><div class="filter-card"><div class="stone-grid"><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div></div><div class="stone-scrim"></div><div class="heading">Filters</div><div class="filter-fields scroll-pane">        <label>Class</label><select data-value="draft_class_line" ><option value="255">Any</option><option value="0">Dark Wizard</option><option value="1">Dark Knight</option><option value="2">Fairy Elf</option><option value="3">Magic Gladiator</option><option value="4">Dark Lord</option><option value="5">Summoner</option><option value="6">Rage Fighter</option></select>
<label>Family</label><select data-value="draft_family" ><option value="0">Any</option><option value="1">Normal</option><option value="2">Excellent</option><option value="3">Ancient</option><option value="4">Socket</option></select>
        <div data-if="draft_family == '3' || draft_ancient_set != ''"><label>Set</label><select data-value="draft_ancient_set" ><option data-for="choice : sets" data-attr-value="choice.value">{{choice.label}}</option></select></div>


        <div class="range"><label>Upgrade min<select data-value="draft_upgrade_min"><option value="0">+0</option><option value="1">+1</option><option value="2">+2</option><option value="3">+3</option><option value="4">+4</option><option value="5">+5</option><option value="6">+6</option><option value="7">+7</option><option value="8">+8</option><option value="9">+9</option><option value="10">+10</option><option value="11">+11</option><option value="12">+12</option><option value="13">+13</option><option value="14">+14</option><option value="15">+15</option></select></label><label>Upgrade max<select data-value="draft_upgrade_max"><option value="0">+0</option><option value="1">+1</option><option value="2">+2</option><option value="3">+3</option><option value="4">+4</option><option value="5">+5</option><option value="6">+6</option><option value="7">+7</option><option value="8">+8</option><option value="9">+9</option><option value="10">+10</option><option value="11">+11</option><option value="12">+12</option><option value="13">+13</option><option value="14">+14</option><option value="15">+15</option></select></label></div>
        <div class="toggle-pair"><button class="filter-toggle" data-event-click="draft_luck"><span class="checkbox-box" data-class-checked="draft_luck"></span><span>Luck</span></button><button class="filter-toggle" data-event-click="draft_skill"><span class="checkbox-box" data-class-checked="draft_skill"></span><span>Skill</span></button></div>
        <div data-if="draft_family == '2' || option != '0' || draft_option != '0'"><label>Option 2</label><select data-value="draft_option"><option data-for="choice : options" data-attr-value="choice.value">{{choice.label}}</option></select><label>Min. options</label><select data-value="draft_min_excellent"><option value="0">Any</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select></div><div data-if="draft_family == '4' || draft_min_sockets != '0'"><label>Min. sockets</label><select data-value="draft_min_sockets"><option value="0">Any</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></div><label>Max price</label><input class="text-field" type="text" maxlength="24" data-value="draft_max_price" />
</div><div class="review-actions"><button class="quiet" data-event-click="cancel_filters">Cancel</button><button class="btn action" data-event-click="apply_filters">Apply</button></div></div></div>
  <div class="review-shade" data-if="review"><div class="review-card"><div class="stone-grid"><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div><div class="stone-tile"></div></div><div class="stone-scrim"></div><div class="heading">{{confirm_title}}</div><div class="review-name">{{confirm_name}}</div><div class="muted review-detail" data-if="confirm_detail != ''">{{confirm_detail}}</div><div class="gold">{{confirm_total}}</div><div class="muted">{{confirm_fee}}</div><div class="muted">{{confirm_balance}}</div><div class="review-actions"><button class="quiet" data-event-click="dismiss" data-class-disabled="busy">Back</button><button id="confirm-action" class="btn action" data-event-click="confirm" data-class-disabled="busy">{{confirm_action}}</button></div><div class="muted" data-if="busy">Pending…</div></div></div>
</div>
</body></rml>
