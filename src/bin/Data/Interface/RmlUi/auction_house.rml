<rml>
<head><title>Auction House</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="auction_house.rcss"/></head>
<body data-model="auction_house">
<div id="panel" class="center-both" data-class-working="busy" data-class-reviewing="review">
  <div id="titlebar"><div class="heading">Auction House <span class="muted">· Zyro</span></div><span class="wallet">{{wallet}}</span><button class="close" data-event-click="close" title="Close">×</button></div>
  <div class="tabs">
    <button data-class-active="tab == 'browse'" data-event-click="tab('browse')">Browse</button>
    <button data-class-active="tab == 'sell'" data-event-click="tab('sell')">Sell</button>
    <button data-class-active="tab == 'own'" data-event-click="tab('own')">My auctions</button>
    <button data-class-active="tab == 'collection'" data-event-click="tab('collection')">Collection <span class="badge" data-if="pending > 0">{{pending}}</span></button>
  </div>
  <div class="workspace">
    <div class="filters scroll-pane" data-if="tab == 'browse'">
      <label>Category</label><select data-value="category" data-event-change="category"><option value="0">Equipment</option><option value="1">Jewels</option><option value="2">Materials</option></select>
      <div data-if="!goods">
        <label>Equipment</label><select data-value="equipment" data-event-change="equipment"><option value="0">All equipment</option><option value="1">Weapons</option><option value="2">Armor</option><option value="3">Wings</option><option value="4">Accessories</option></select>
        <div data-if="types.size > 1"><label>Type</label><select data-value="item_type" data-event-change="filter"><option data-for="choice : types" data-attr-value="choice.value">{{choice.label}}</option></select></div>
      </div>
      <label>Name</label><input class="text-field" type="text" maxlength="64" data-value="search" data-event-change="filter"/>
      <div data-if="!goods">
        <div data-if="options.size > 1"><label>Option</label><select data-value="option" data-event-change="filter"><option data-for="choice : options" data-attr-value="choice.value">{{choice.label}}</option></select></div>
        <label>Family</label><select data-value="family" data-event-change="filter"><option value="0">Any</option><option value="1">Normal</option><option value="2">Excellent</option><option value="3">Ancient</option><option value="4">Socket</option></select>
        <div data-if="family == '3' || ancient_set != ''"><label>Set</label><select data-value="ancient_set" data-event-change="filter"><option data-for="choice : sets" data-attr-value="choice.value">{{choice.label}}</option></select></div>
        <label>Class</label><select data-value="class_line" data-event-change="filter"><option value="255">Any</option><option value="0">Dark Wizard</option><option value="1">Dark Knight</option><option value="2">Fairy Elf</option><option value="3">Magic Gladiator</option><option value="4">Dark Lord</option><option value="5">Summoner</option><option value="6">Rage Fighter</option></select>
        <label class="toggle"><input type="checkbox" data-checked="usable" data-event-change="filter"/>Can equip now</label>
        <label>Upgrade</label><div class="range"><input class="text-field" type="text" maxlength="2" data-value="upgrade_min" data-event-change="filter"/><span>–</span><input class="text-field" type="text" maxlength="2" data-value="upgrade_max" data-event-change="filter"/></div>
        <div class="toggle-pair"><label class="toggle"><input type="checkbox" data-checked="luck" data-event-change="filter"/>Luck</label><label class="toggle"><input type="checkbox" data-checked="skill" data-event-change="filter"/>Skill</label></div>
        <div class="range"><label>Min. options<br/><input class="text-field" type="text" maxlength="1" data-value="min_excellent" data-event-change="filter"/></label><label>Sockets<br/><input class="text-field" type="text" maxlength="1" data-value="min_sockets" data-event-change="filter"/></label></div>
        <label>Max price</label><input class="text-field" type="text" maxlength="24" data-value="max_price" data-event-change="filter"/>
        <label>Sort</label><select data-value="sort" data-event-change="filter"><option value="0">Lowest price</option><option value="1">Highest price</option></select>
      </div>
      <button class="quiet" data-event-click="reset">Reset filters</button>
    </div>
    <div class="main" data-if="tab != 'sell'">
      <div class="list-toolbar"><span>{{count}}</span><button class="quiet" data-event-click="refresh">Refresh</button><button class="btn action" data-if="tab == 'collection' &amp;&amp; rows.size > 0" data-event-click="claim(-1)" data-class-disabled="busy">Collect all</button></div>
      <div id="results" class="scroll-pane">
        <div class="listing" data-class-selected="row.selected" data-for="row : rows" data-event-click="select(row.index)" data-event-mouseover="hover(row.index)" data-event-mouseout="leave">
          <img class="item-icon" data-attr-id="'row-icon-' + row.index"/>
          <div class="listing-copy"><div class="item-name" data-class-excellent="row.tone == 'excellent'" data-class-ancient="row.tone == 'ancient'" data-class-socket="row.tone == 'socket'">{{row.name}}</div><div class="row-preview" data-if="row.matched == ''">{{row.detail}}</div><div class="matched" data-if="row.matched != ''">{{row.matched}}</div><div class="muted">{{row.meta}}</div><span class="danger" data-if="row.cannot_equip">Cannot Equip</span></div>
          <div class="listing-action"><div class="gold">{{row.price}}</div><span class="muted" data-if="row.own">Yours</span><button class="quiet" data-if="tab == 'own'" data-event-click="cancel_listing(row.index)">Cancel</button><button class="btn action" data-if="tab == 'collection'" data-event-click="claim(row.index)">Collect</button></div>
        </div>
        <div class="loading" data-if="loading &amp;&amp; rows.size > 0">Loading…</div><button class="quiet more" data-if="more &amp;&amp; !loading" data-event-click="more">Load more</button>
      </div>
    </div>
    <div class="main" data-if="tab == 'sell'">
      <div class="list-toolbar"><span>Inventory</span><button class="quiet" data-event-click="refresh">Refresh</button></div>
      <div class="inventory scroll-pane"><button class="inventory-item" data-for="row, row_index : inventory" data-event-click="inventory(row.index)" data-event-mouseover="inventory_hover(row_index)" data-event-mouseout="leave"><img class="item-icon" data-attr-id="'inventory-icon-' + row_index"/><span data-class-excellent="row.tone == 'excellent'" data-class-ancient="row.tone == 'ancient'" data-class-socket="row.tone == 'socket'">{{row.name}}</span></button></div>
    </div>
    <div class="details scroll-pane" data-if="tab == 'browse' || tab == 'sell'">
      <div data-if="selected">
        <img id="selected-icon" class="selected-icon"/><div class="item-name" data-class-excellent="selected_tone == 'excellent'" data-class-ancient="selected_tone == 'ancient'" data-class-socket="selected_tone == 'socket'">{{selected_name}}</div>
        <div class="item-detail">{{selected_detail}}</div><span class="danger" data-if="cannot_equip &amp;&amp; tab == 'browse'">Cannot Equip</span>
        <div data-if="tab == 'browse'">
          <div class="gold selected-price" data-if="!goods">{{selected_price}} Zen</div>
          <div data-if="goods"><label>Quantity</label><input class="text-field" type="text" maxlength="10" data-value="buy_quantity" data-event-change="quote"/><div class="muted">{{stock}}</div><div class="gold selected-price">{{quote_total}}</div></div>
          <button class="btn action primary" data-event-click="buy" data-class-disabled="busy || loading">Review purchase</button>
        </div>
        <div data-if="tab == 'sell'">
          <div data-if="sell_goods"><label>Quantity</label><input class="text-field" type="text" maxlength="10" data-value="quantity" data-event-change="sell_change"/><div class="muted">{{stock}}</div></div>
          <label data-if="sell_goods">Unit price</label><label data-if="!sell_goods">Price</label>
          <div class="price-input"><button class="quiet step" data-if="sell_goods" data-event-click="minus" data-class-disabled="!step_down || busy">−</button><input class="text-field" type="text" maxlength="24" data-value="price" data-event-change="sell_change"/><button class="quiet step" data-if="sell_goods" data-event-click="plus" data-class-disabled="!step_up || busy">+</button></div>
          <div class="duration" data-if="duration != ''">{{duration}}</div><select data-if="duration == ''" data-value="duration_value" data-event-change="sell_change"><option data-for="choice : durations" data-attr-value="choice.value">{{choice.label}}</option></select>
          <div class="fee-row" data-if="sell_goods"><span>Total</span><span>{{sale_total}}</span></div><div class="fee-row"><span>Posting fee</span><span>{{posting_fee}}</span></div><div class="fee-row"><span>Sale fee</span><span>{{sale_fee}}</span></div><div class="fee-row gold"><span>You receive</span><span>{{proceeds}}</span></div>
          <button class="btn action primary" data-event-click="sell" data-class-disabled="!sell_ready || busy">Review listing</button>
        </div>
      </div><div class="empty" data-if="!selected &amp;&amp; tab == 'sell'">Select an item</div>
    </div>
  </div>
  <div class="status" data-if="status != ''">{{status}}</div>
  <div class="review-shade" data-if="review"><div class="review-card"><div class="heading">{{confirm_title}}</div><div class="review-name">{{confirm_name}}</div><div class="gold">{{confirm_total}}</div><div class="muted">{{confirm_fee}}</div><div class="muted">{{confirm_balance}}</div><div class="review-actions"><button class="quiet" data-event-click="dismiss" data-class-disabled="busy">Back</button><button id="confirm-action" class="btn action" data-event-click="confirm" data-class-disabled="busy">{{confirm_action}}</button></div><div class="muted" data-if="busy">Pending…</div></div></div>
</div>
</body></rml>
